---
import { siteConfig } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  siteSettings?: {
    socialProofText?: string;
    heroBadgeText?: string;
    whatsappNumber?: string;
    foundedYear?: number;
    [key: string]: any;
  };
}

const { siteSettings } = Astro.props;
const heroBadge = siteSettings?.heroBadgeText || 'Dipercaya 1000+ Orang Tua di Surabaya & Sidoarjo';
const heroHeadline = siteSettings?.homepage?.heroHeadline || 'Perawatan Ibu & Bayi di Rumah oleh Bidan Profesional';
const heroTagline = siteSettings?.homepage?.heroTagline || 'Bunda Juga Berhak Dirawat dan Ditemani 🤍';
const heroDescription = siteSettings?.homepage?.heroDescription || 'Menjadi ibu penuh kebahagiaan, tetapi terkadang juga melelahkan. Kala hadir langsung ke rumah untuk membantu Bunda merawat diri dan si kecil, dengan sentuhan lembut serta pendampingan yang hangat.';
const capacityPerDay = siteConfig.promotion.capacityPerDay;
const phone = siteSettings?.whatsappNumber || siteConfig.whatsappNumber;

const defaultTrustPoints = [
  { title: 'Bidan Profesional:', description: 'Perawatan oleh tenaga kesehatan terlatih.' },
  { title: 'Untuk Ibu & Si Kecil:', description: 'Beragam treatment dalam satu kunjungan.' },
  { title: 'Nyaman di Rumah:', description: 'Tanpa repot bepergian atau macet.' },
  { title: 'Perawatan Personal:', description: 'Disesuaikan dengan kebutuhan Bunda dan si kecil.' },
];
const trustPoints = (siteSettings?.homepage?.trustBadges && siteSettings.homepage.trustBadges.length > 0)
  ? siteSettings.homepage.trustBadges
  : defaultTrustPoints;
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden bg-gradient-to-b from-[#FFF9F4] via-[#FFEFE5]/40 to-[#FFF9F4]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text Column (Left) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#FFEFE5] border border-[#F6DCCD] text-[#B3471E] font-semibold text-xs sm:text-sm mb-6 shadow-sm">
          <span class="inline-block w-2 h-2 rounded-full bg-[#0E733D] animate-pulse"></span>
          <span>{heroBadge}</span>
        </div>

        <!-- Single H1 Title -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-brand font-medium text-[#4B2E22] tracking-tight leading-[1.18] mb-5">
          {heroHeadline}
        </h1>

        <!-- Tagline / Subtitle -->
        <p class="text-lg sm:text-xl font-medium text-[#B3471E] mb-4 font-brand">
          {heroTagline}
        </p>

        <!-- Descriptive Paragraph -->
        <p class="text-base sm:text-lg text-[#86675A] leading-relaxed mb-8 max-w-2xl">
          {heroDescription}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
          <WhatsAppButton
            refCode="KALA-HOME"
            message="Halo Bu Bidan, saya mau konsultasi homecare untuk ibu dan bayi"
            text="Konsultasi via WhatsApp"
            variant="primary"
            className="text-base py-4 px-8"
            phone={phone}
          />
          <a
            href="/layanan"
            class="inline-flex items-center justify-center rounded-2xl border-2 border-[#F6DCCD] bg-white px-7 py-3.5 text-base font-bold text-[#4B2E22] transition-colors hover:bg-[#FFEFE5]/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B3471E] focus-visible:ring-offset-2"
          >
            Lihat Semua Layanan
          </a>
        </div>

        <div class="mt-8 flex items-center gap-3">
          <div class="flex -space-x-2 overflow-hidden">
            <span class="inline-block h-8 w-8 rounded-full ring-2 ring-white bg-[#FFD9C4] text-center leading-8 text-xs font-bold text-[#4B2E22]">B1</span>
            <span class="inline-block h-8 w-8 rounded-full ring-2 ring-white bg-[#FFEFE5] text-center leading-8 text-xs font-bold text-[#B3471E]">B2</span>
            <span class="inline-block h-8 w-8 rounded-full ring-2 ring-white bg-[#F6DCCD] text-center leading-8 text-xs font-bold text-[#4B2E22]">B3</span>
          </div>
          <span class="text-xs sm:text-sm font-semibold text-[#86675A]">
            Tim bidan terlatih & berizin siap mendampingi Bunda
          </span>
        </div>
      </div>

      <!-- Illustration / Highlight Column (Right) -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Background Glow -->
          <div class="absolute -top-6 -left-6 w-72 h-72 bg-[#FFD9C4] rounded-full filter blur-3xl opacity-60 pointer-events-none"></div>
          <div class="absolute -bottom-6 -right-6 w-72 h-72 bg-[#FFEFE5] rounded-full filter blur-3xl opacity-70 pointer-events-none"></div>

          <!-- Feature Card Illustration -->
          <div class="relative bg-white border-2 border-[#F6DCCD] rounded-3xl p-6 sm:p-8 shadow-kala text-[#4B2E22]">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-[#F6DCCD]/60">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-[#FFEFE5] flex items-center justify-center text-[#B3471E] font-bold text-xl">
                  👶
                </div>
                <div>
                  <h2 class="font-brand font-bold text-base text-[#4B2E22] leading-tight">Layanan Homecare Kala</h2>
                  <p class="text-xs text-[#86675A]">Kenyamanan Maksimal di Rumah</p>
                </div>
              </div>
              <span class="text-xs font-bold px-3 py-1 bg-[#0E733D]/10 text-[#0E733D] rounded-full">Bidan Bersertifikat</span>
            </div>

            <ul class="space-y-4 text-sm text-[#4B2E22]">
              {trustPoints.map((tp) => (
                <li class="flex items-start gap-3">
                  <span class="w-5 h-5 rounded-full bg-[#FFD9C4] text-[#B3471E] flex items-center justify-center text-xs flex-shrink-0 mt-0.5 font-bold">✓</span>
                  <div>
                    <span class="font-bold text-[#4B2E22]">{tp.title.endsWith(':') ? tp.title : `${tp.title}:`}</span>
                    <span class="text-[#86675A]"> {tp.description}</span>
                  </div>
                </li>
              ))}
            </ul>

            <div class="mt-6 pt-4 border-t border-[#F6DCCD]/60 bg-[#FFF9F4] -mx-6 -mb-6 px-6 py-4 rounded-b-3xl">
              <div class="flex items-center justify-between gap-2 text-xs text-[#86675A]">
                <span>Konsultasi awal & tanya jadwal:</span>
                <span class="whitespace-nowrap font-bold text-[#0E733D]">Maks {capacityPerDay} sesi/hari</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
