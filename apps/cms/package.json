{
  "name": "cms-kala",
  "version": "1.0.0",
  "description": "Payload CMS for Kala Moms and Baby Spa",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3005",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3005",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/seed.ts",
    "set:superadmin": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/set-superadmin.ts",
    "audit:backfill": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/audit-backfill.ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.10.0",
    "next": "15.4.11",
    "payload": "3.91.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
