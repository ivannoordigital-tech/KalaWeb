---
interface Props {
  block: {
    title?: string;
    subtitle?: string;
    items: Array<{ value: string; label: string; icon?: string }>;
    columns?: '2' | '3' | '4';
    background?: 'white' | 'cream' | 'peach';
    style?: 'plain' | 'card';
  };
}

const { block } = Astro.props;

const bgClasses: Record<string, string> = {
  white: 'bg-white',
  cream: 'bg-[#FFF9F4]',
  peach: 'bg-[#FFEFE5]',
};
const columnClasses: Record<string, string> = {
  '2': 'grid-cols-1 sm:grid-cols-2',
  '3': 'grid-cols-1 sm:grid-cols-3',
  '4': 'grid-cols-2 sm:grid-cols-4',
};
const isCard = block.style === 'card';
---

<section class={`py-12 md:py-16 border-y border-[#F6DCCD] ${bgClasses[block.background || 'cream'] || bgClasses.cream}`}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    {(block.title || block.subtitle) && (
      <div class="text-center mb-8">
        {block.title && (
          <h2 class="text-2xl sm:text-3xl font-brand font-bold text-[#4B2E22]">{block.title}</h2>
        )}
        {block.subtitle && (
          <p class="mt-2 text-sm sm:text-base text-[#86675A] leading-relaxed max-w-2xl mx-auto">{block.subtitle}</p>
        )}
      </div>
    )}
    <div class={`grid gap-4 sm:gap-6 ${columnClasses[block.columns || '3'] || columnClasses['3']}`}>
      {(block.items || []).map((item) => (
        <div class={`text-center ${isCard ? 'bg-white rounded-2xl border border-[#F6DCCD] p-6 shadow-sm' : 'p-4'}`}>
          {item.icon && <div class="text-2xl mb-2" aria-hidden="true">{item.icon}</div>}
          <div class="text-3xl sm:text-4xl font-brand font-bold text-[#B3471E] leading-none">
            {item.value}
          </div>
          <div class="mt-2 text-xs sm:text-sm font-medium text-[#86675A]">
            {item.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
