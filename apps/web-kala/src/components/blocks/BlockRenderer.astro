---
import HeroBlock from './HeroBlock.astro';
import PainPointsBlock from './PainPointsBlock.astro';
import SolutionsBlock from './SolutionsBlock.astro';
import PricingPackagesBlock from './PricingPackagesBlock.astro';
import ComparisonTableBlock from './ComparisonTableBlock.astro';
import StepsFlowBlock from './StepsFlowBlock.astro';
import TestimonialsBlock from './TestimonialsBlock.astro';
import GuaranteeBlock from './GuaranteeBlock.astro';
import FaqAccordionBlock from './FaqAccordionBlock.astro';
import RichTextBlock from './RichTextBlock.astro';
import CallToActionBlock from './CallToActionBlock.astro';
import GalleryBlock from './GalleryBlock.astro';
import MidwifeSpotlightBlock from './MidwifeSpotlightBlock.astro';
import ContainerBlock from './ContainerBlock.astro';
import FeaturedServicesBlock from './FeaturedServicesBlock.astro';
import ValuePropsBlock from './ValuePropsBlock.astro';
import CoverageAreaBlock from './CoverageAreaBlock.astro';
import HeadingBlock from './widgets/HeadingBlock.astro';
import TextBlock from './widgets/TextBlock.astro';
import ImageBlock from './widgets/ImageBlock.astro';
import ButtonBlock from './widgets/ButtonBlock.astro';
import SpacerBlock from './widgets/SpacerBlock.astro';
import DividerBlock from './widgets/DividerBlock.astro';
import IconBoxBlock from './widgets/IconBoxBlock.astro';
import VideoBlock from './widgets/VideoBlock.astro';
import MapBlock from './widgets/MapBlock.astro';
import CardBlock from './widgets/CardBlock.astro';
import HtmlBlock from './widgets/HtmlBlock.astro';

interface Props {
  block: {
    id?: string;
    blockType: string;
    disabled?: boolean;
    [key: string]: any;
  };
  isPreview?: boolean;
  siteSettings?: any;
}

const {
  block,
  isPreview = Astro.url.pathname.startsWith('/preview/'),
  siteSettings,
} = Astro.props;

// If section is disabled and this is public production, DO NOT RENDER
if (!isPreview && block?.disabled) {
  return;
}

const KNOWN_BLOCK_TYPES = [
  'hero',
  'painPoints',
  'solutions',
  'pricing',
  'comparison',
  'steps',
  'testimonials',
  'guarantee',
  'faq',
  'richText',
  'cta',
  'gallery',
  'templateRef',
  'midwifeSpotlight',
  'container',
  'featuredServices',
  'valueProps',
  'coverageArea',
  'heading',
  'text',
  'image',
  'button',
  'spacer',
  'divider',
  'iconBox',
  'video',
  'map',
  'card',
  'html',
];

if (!block || !block.blockType) {
  if (import.meta.env.PROD && !isPreview) {
    throw new Error('[BlockRenderer] Fatal: Ditemukan blok tanpa tipe (blockType) yang valid pada build produksi.');
  }
} else if (!KNOWN_BLOCK_TYPES.includes(block.blockType)) {
  if (import.meta.env.PROD && !isPreview) {
    throw new Error(`[BlockRenderer] Fatal: Blok tidak dikenal "${block.blockType}". Halaman berisiko kehilangan bagian penting.`);
  } else {
    console.warn(`[BlockRenderer] Peringatan: Blok tidak dikenal "${block.blockType}".`);
  }
}

// Ekstrak layout jika blok ini adalah TemplateRef
const templateLayout = block?.blockType === 'templateRef' && typeof block.template === 'object' && Array.isArray(block.template?.layout)
  ? block.template.layout
  : [];
---

{block && (
  <div
    class={isPreview && block.disabled ? 'opacity-45 relative group my-2' : undefined}
    data-kala-section-id={block.id}
    data-kala-block-type={block.blockType}
    data-kala-disabled={block.disabled ? 'true' : undefined}
  >
    {isPreview && block.disabled && (
      <div class="bg-amber-500 text-slate-950 text-xs font-bold px-2.5 py-0.5 rounded absolute top-2 right-2 z-40 shadow pointer-events-none uppercase tracking-wide">
        Disembunyikan
      </div>
    )}

    {block.blockType === 'hero' && <HeroBlock block={block as any} />}
    {block.blockType === 'painPoints' && <PainPointsBlock block={block as any} />}
    {block.blockType === 'solutions' && <SolutionsBlock block={block as any} />}
    {block.blockType === 'pricing' && <PricingPackagesBlock block={block as any} />}
    {block.blockType === 'comparison' && <ComparisonTableBlock block={block as any} />}
    {block.blockType === 'steps' && <StepsFlowBlock block={block as any} />}
    {block.blockType === 'testimonials' && <TestimonialsBlock block={block as any} />}
    {block.blockType === 'guarantee' && <GuaranteeBlock block={block as any} />}
    {block.blockType === 'faq' && <FaqAccordionBlock block={block as any} />}
    {block.blockType === 'richText' && <RichTextBlock block={block as any} />}
    {block.blockType === 'cta' && <CallToActionBlock block={block as any} />}
    {block.blockType === 'gallery' && <GalleryBlock block={block as any} />}
    {block.blockType === 'midwifeSpotlight' && <MidwifeSpotlightBlock block={block as any} />}
    {block.blockType === 'featuredServices' && <FeaturedServicesBlock block={block as any} siteSettings={siteSettings} />}
    {block.blockType === 'valueProps' && <ValuePropsBlock block={block as any} siteSettings={siteSettings} />}
    {block.blockType === 'coverageArea' && <CoverageAreaBlock block={block as any} siteSettings={siteSettings} />}

    <!-- Layout container & widgets -->
    {block.blockType === 'container' && (
      <ContainerBlock block={block as any} isPreview={isPreview} siteSettings={siteSettings} />
    )}
    {block.blockType === 'heading' && <HeadingBlock block={block as any} siteSettings={siteSettings} />}
    {block.blockType === 'text' && <TextBlock block={block as any} siteSettings={siteSettings} />}
    {block.blockType === 'image' && <ImageBlock block={block as any} siteSettings={siteSettings} />}
    {block.blockType === 'button' && <ButtonBlock block={block as any} siteSettings={siteSettings} />}
    {block.blockType === 'spacer' && <SpacerBlock block={block as any} siteSettings={siteSettings} />}
    {block.blockType === 'divider' && <DividerBlock block={block as any} siteSettings={siteSettings} />}
    {block.blockType === 'iconBox' && <IconBoxBlock block={block as any} siteSettings={siteSettings} />}
    {block.blockType === 'video' && <VideoBlock block={block as any} siteSettings={siteSettings} />}
    {block.blockType === 'map' && <MapBlock block={block as any} siteSettings={siteSettings} />}
    {block.blockType === 'card' && <CardBlock block={block as any} siteSettings={siteSettings} />}
    {block.blockType === 'html' && <HtmlBlock block={block as any} siteSettings={siteSettings} />}

    <!-- Render template tersimpan secara modular -->
    {block.blockType === 'templateRef' && templateLayout.map((innerBlock: any) => (
      <Astro.self block={innerBlock} isPreview={isPreview} siteSettings={siteSettings} />
    ))}
  </div>
)}
