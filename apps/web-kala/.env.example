# URL CMS Payload (Backend VPS)
PAYLOAD_URL=https://admin.kalababyspa.com

# ==============================================================================
# PRATINJAU DRAFT (VISUAL BUILDER) — WAJIB untuk tombol Preview di CMS
# ==============================================================================
# Harus SAMA PERSIS dengan PREVIEW_SECRET di apps/cms/.env (minimal 32 karakter).
PREVIEW_SECRET=ganti_dengan_secret_preview_minimal_32_karakter_acak_2026

# API Key user CMS yang boleh membaca draft (Payload > Users > API Key).
# Gunakan akun khusus preview dengan role read-only jika tersedia.
PREVIEW_API_KEY=

# Opsional: URL CMS untuk pengambilan draft (default: PAYLOAD_URL).
PREVIEW_API_URL=

# Opsional: Cloudflare Access Service Token jika CMS dilindungi Cloudflare Access.
PREVIEW_CF_ACCESS_CLIENT_ID=
PREVIEW_CF_ACCESS_CLIENT_SECRET=

# Pelacakan & Pixel (GTM, Meta, GA4, TikTok, Clarity)
# Seluruh konfigurasi ID pelacakan sekarang dikelola 100% terpusat melalui
# Payload CMS Admin UI -> Pengaturan Situs -> Tab "📊 Pelacakan & Pixel".

# Fallback Mode Behavior:
# 'true': (Default di local dev) Memperbolehkan fallback ke data lokal site.ts jika CMS offline.
# 'false': (Set di Cloudflare Pages Dashboard Production) Build AKAN GAGAL jika CMS tidak terjangkau,
#          sehingga Cloudflare Pages otomatis mempertahankan deployment live sebelumnya (zero downtime).
ALLOW_FALLBACK=true
