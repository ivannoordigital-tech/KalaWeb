---
import WhatsAppButton from '../WhatsAppButton.astro';
import { fetchSiteSettings } from '../../lib/payload';

interface Props {
  block: {
    badge?: string;
    title: string;
    description?: string;
    price?: string;
    originalPrice?: string;
    discountBadge?: string;
    note?: string;
    capacityNote?: string;
    serviceName?: string;
    buttonText?: string;
    refCode?: string;
    message?: string;
  };
}

const { block } = Astro.props;
const cmsSettings = await fetchSiteSettings();
const phone = cmsSettings?.whatsappNumber;
---

<section id="promo" class="py-14 md:py-20 bg-[#FFF9F4]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-[2rem] bg-[#A8431F] px-6 py-10 sm:px-10 md:grid md:grid-cols-[1.4fr_1fr] md:items-center md:gap-10 shadow-kala">
      <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/10" aria-hidden="true"></div>
      <div class="absolute -bottom-14 left-1/3 h-40 w-40 rounded-full bg-[#F5C24E]/10" aria-hidden="true"></div>

      <div class="relative">
        <span class="inline-block text-[11px] font-bold tracking-wider uppercase text-white bg-white/10 px-3 py-1 rounded-full">
          {block.badge || 'Penawaran Reservasi Pertama'}
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-white mt-4 mb-3">
          {block.title}
        </h2>
        {block.description && (
          <p class="text-sm sm:text-base text-white leading-relaxed">{block.description}</p>
        )}

        <div class="mt-5 flex flex-wrap items-baseline gap-3">
          {block.originalPrice && (
            <s class="text-lg text-white font-medium">{block.originalPrice}</s>
          )}
          {block.price && (
            <b class="font-brand text-4xl sm:text-5xl text-[#F5C24E]">{block.price}</b>
          )}
          {block.discountBadge && (
            <span class="text-xs font-extrabold uppercase tracking-wide text-[#3A2A00] bg-[#F5C24E] px-2.5 py-1 rounded-lg">
              {block.discountBadge}
            </span>
          )}
        </div>
        {block.note && <p class="text-xs text-white/90 mt-3">{block.note}</p>}
        {block.capacityNote && (
          <p class="mt-3 inline-flex items-center gap-2 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-semibold text-white">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#F5C24E]" aria-hidden="true"></span>
            {block.capacityNote}
          </p>
        )}
      </div>

      <div class="relative mt-8 md:mt-0">
        <WhatsAppButton
          refCode={block.refCode || 'KALA-PROMO-INTRO'}
          message={block.message || 'Halo Bu Bidan, saya mau ambil promo treatment Kala'}
          text={block.buttonText || 'Ambil Promo via WhatsApp'}
          variant="promo"
          className="w-full"
          phone={phone}
        />
        {block.serviceName && (
          <p class="text-xs text-white/90 text-center mt-3">{block.serviceName}</p>
        )}
      </div>
    </div>
  </div>
</section>
