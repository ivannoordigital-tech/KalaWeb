{
  "name": "kala-web-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Kala Moms and Baby Spa digital platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web-kala",
    "dev:cms": "npm run dev --workspace=cms-kala",
    "convert:images": "node scripts/convert-webp.mjs",
    "build": "npm run build --workspace=web-kala",
    "build:cms": "npm run build --workspace=cms-kala",
    "set:superadmin": "npm run set:superadmin --workspace=cms-kala",
    "audit:seo": "node scripts/audit-seo.mjs",
    "test:role": "npm run test:role --workspace=cms-kala",
    "test:validation": "npm run test:validation --workspace=cms-kala",
    "test:contract": "node apps/automation/test/contract.test.mjs",
    "test:articles": "node scripts/verify-articles.mjs",
    "test:landing": "node scripts/verify-landing-pages.mjs",
    "test:media": "node scripts/verify-media-health.mjs",
    "test:integration": "npm run test:integration --workspace=cms-kala",
    "import:articles": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=apps/cms/.env apps/cms/src/scripts/import-articles.ts",
    "import:articles:dry": "cross-env DRY_RUN=true NODE_OPTIONS=--no-deprecation tsx --env-file=apps/cms/.env apps/cms/src/scripts/import-articles.ts",
    "migrate:landing": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=apps/cms/.env apps/cms/src/scripts/migrate-landing-pages.ts",
    "seed:homepage": "npm run seed:homepage --workspace=cms-kala",
    "seed:homepage:dry": "cross-env DRY_RUN=true npm run seed:homepage --workspace=cms-kala",
    "seed:homepage:force": "npm run seed:homepage:force --workspace=cms-kala",
    "migrate:landing:dry": "cross-env DRY_RUN=true NODE_OPTIONS=--no-deprecation tsx --env-file=apps/cms/.env apps/cms/src/scripts/migrate-landing-pages.ts",
    "preview": "npm run preview --workspace=web-kala"
  }
}
