---
import { siteConfig } from '../config/site';
---

<section id="pembeda" class="py-16 md:py-24 bg-white border-y border-[#F6DCCD]/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs font-bold tracking-wider text-[#C2552B] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD]">
        Kenapa Memilih Kala?
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-medium text-[#4B2E22] mt-4 mb-4">
        5 Hal yang Membuat Kala Berbeda
      </h2>
      <p class="text-sm sm:text-base text-[#86675A] leading-relaxed">
        Setiap kunjungan Kala menghadirkan perawatan profesional, perhatian yang tulus, dan kenyamanan untuk Bunda serta si kecil.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6 sm:gap-8">
      {siteConfig.differentiators.map((item, index) => (
        <div class={`p-7 rounded-3xl border border-[#F6DCCD] bg-[#FFF9F4] hover:shadow-kala transition-all duration-300 flex flex-col justify-between ${
          index < 3 ? 'lg:col-span-2' : 'lg:col-span-3'
        }`}>
          <div>
            <div class="flex items-center gap-3 mb-3">
              <span class="w-9 h-9 rounded-2xl bg-[#FFEFE5] text-[#C2552B] font-brand font-bold flex items-center justify-center text-sm border border-[#F6DCCD] flex-shrink-0">
                {item.number}
              </span>
              <h3 class="font-brand font-semibold text-lg text-[#4B2E22] leading-snug">
                {item.title}
              </h3>
            </div>
            <div class="inline-block text-xs font-semibold text-[#C2552B] bg-white px-3 py-1 rounded-full border border-[#F6DCCD] mb-3">
              {item.subtitle}
            </div>
            <p class="text-sm text-[#86675A] leading-relaxed">
              {item.description}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-[#F6DCCD]/60 flex items-center text-xs font-bold text-[#C2552B]">
            <span>Kenyamanan Homecare Kala</span>
            <span class="ml-1">✓</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
