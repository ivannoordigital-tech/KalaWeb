                    <p class="text-xs text-[#86675A] leading-relaxed">{sol.desc}</p>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )}

        <!-- 4. 3-STEP EASY FLOW -->
        {campaign.steps && campaign.steps.length > 0 && (
          <section class="py-12 md:py-16 bg-white border-b border-[#F6DCCD]">
            <div class="max-w-3xl mx-auto px-4 text-center">
              <h2 class="text-2xl sm:text-3xl font-brand font-bold text-[#4B2E22] mb-8">
                Cara Kerja Praktis 3 Langkah
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                {campaign.steps.map((step) => (
                  <div class="p-6 rounded-2xl bg-[#FFF9F4] border border-[#F6DCCD]">
                    <div class="w-10 h-10 rounded-full bg-[#FFEFE5] text-[#B3471E] font-bold text-base flex items-center justify-center mx-auto mb-4 border border-[#F6DCCD]">
                      {step.num}
                    </div>
                    <h3 class="font-brand font-bold text-base text-[#4B2E22] mb-2">{step.title}</h3>
                    <p class="text-xs text-[#86675A] leading-relaxed">{step.desc}</p>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )}

        <!-- 5. SOCIAL PROOF & TESTIMONIAL -->
        {campaign.testimonial && (
          <section class="py-12 md:py-16 bg-[#FFF9F4] border-b border-[#F6DCCD]">
            <div class="max-w-3xl mx-auto px-4">
              <div class="bg-white p-8 rounded-3xl border-2 border-[#F6DCCD] shadow-kala">
                <div class="flex items-center gap-1 text-[#B3471E] mb-4 text-lg">
                  ★★★★★
                </div>
                <p class="text-base text-[#4B2E22] italic leading-relaxed mb-6 font-medium">
                  "{campaign.testimonial.quote}"
                </p>
                <div class="flex items-center justify-between border-t border-[#F6DCCD]/60 pt-4 text-xs">
                  <span class="font-bold text-[#4B2E22]">{campaign.testimonial.author}</span>
                  <span class="text-[#86675A]">📍 {campaign.testimonial.area}</span>
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- 6. FAQS -->
        {campaign.faqs && campaign.faqs.length > 0 && (
          <section class="py-12 md:py-16 bg-white border-b border-[#F6DCCD]">
            <div class="max-w-3xl mx-auto px-4">
              <h2 class="text-2xl sm:text-3xl font-brand font-bold text-[#4B2E22] text-center mb-8">
                Pertanyaan yang Sering Diajukan Bunda
              </h2>
              <div class="space-y-4">
                {campaign.faqs.map((faq) => (
                  <details class="group p-5 bg-[#FFF9F4] rounded-2xl border border-[#F6DCCD] cursor-pointer">
                    <summary class="font-brand font-bold text-sm sm:text-base text-[#4B2E22] flex items-center justify-between list-none">
                      <span>{faq.q}</span>
                      <span class="text-[#B3471E] font-bold text-lg group-open:rotate-45 transition-transform">+</span>
                    </summary>
                    <p class="mt-3 text-xs sm:text-sm text-[#86675A] leading-relaxed border-t border-[#F6DCCD]/60 pt-3">
                      {faq.a}
                    </p>
                  </details>
                ))}
              </div>
            </div>
          </section>
        )}

        <!-- 7. CLOSING CTA -->
        <section class="py-14 md:py-20 bg-gradient-to-b from-[#FFF9F4] to-[#FFEFE5] text-center">
          <div class="max-w-xl mx-auto px-4">
            <h2 class="text-2xl sm:text-3xl font-brand font-bold text-[#4B2E22] mb-4">
              Si kecil berhak merasa nyaman, Bunda berhak beristirahat tenang.
            </h2>
            <p class="text-sm text-[#86675A] mb-8 leading-relaxed">
