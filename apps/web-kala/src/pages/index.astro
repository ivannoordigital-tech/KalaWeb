---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeaturedServices from '../components/FeaturedServices.astro';
import ValueProps from '../components/ValueProps.astro';
import Testimonials from '../components/Testimonials.astro';
import CoverageArea from '../components/CoverageArea.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { fetchSiteSettings, fetchPayloadFAQs } from '../lib/payload';
import { siteConfig } from '../config/site';

const cmsSettings = await fetchSiteSettings();
const siteSettings = {
  ...siteConfig,
  whatsappNumber: cmsSettings?.whatsappNumber || siteConfig.whatsappNumber,
  whatsappNumberFormatted: cmsSettings?.whatsappNumberFormatted || siteConfig.whatsappNumberFormatted,
  instagram: cmsSettings?.instagram || siteConfig.instagram,
  operationalHours: cmsSettings?.operationalHours || siteConfig.operationalHours,
  socialProofText: cmsSettings?.socialProofText || siteConfig.socialProofText,
  heroBadgeText: cmsSettings?.heroBadgeText || 'HOMECARE IBU & BAYI • SURABAYA & SIDOARJO',
  homepage: cmsSettings?.homepage,
};

const cmsFaqs = await fetchPayloadFAQs();
const capacityFaq = siteConfig.faqs.find(
  (faq) => faq.question === 'Berapa sesi yang bisa dijadwalkan setiap hari?'
);
const faqs = cmsFaqs.length > 0
  ? [
      ...cmsFaqs.map((item) => ({ question: item.question, answer: item.answer })),
      ...(capacityFaq && !cmsFaqs.some((item) => item.question === capacityFaq.question)
        ? [capacityFaq]
        : []),
    ]
  : siteConfig.faqs;

const defaultPainPoints = [
  {
    title: 'Si Kecil Rewel & Sulit Tidur',
    description: 'Sudah digendong dan ditenangkan, tapi si kecil masih gelisah? Bunda ingin membantunya merasa lebih nyaman.',
  },
  {
    title: 'Batuk Pilek Bikin Tidur Tak Nyenyak',
    description: 'Hidung tersumbat, napas berbunyi, dan batuk pilek yang datang-pergi membuat si kecil tidak nyaman. Bunda khawatir, tapi tidak mau sembarangan menangani.',
  },
  {
    title: 'GTM, Makan Jadi Drama',
    description: 'Mulut tertutup, kepala menoleh, makanan ditolak. Bunda cemas apakah asupannya cukup.',
  },
  {
    title: 'ASI Terasa Kurang Lancar',
    description: 'Bunda merasa ASI sulit keluar atau payudara terasa penuh dan tidak nyaman? Rasanya ingin menyusui lebih tenang, tanpa terus dibayangi rasa khawatir.',
  },
  {
    title: 'Cemas, Takut Salah Merawat',
    description: 'Setiap tangisan dan gerak si kecil bikin bertanya-tanya, “Ini normal atau tidak?” Bunda ingin yakin, tapi bingung harus tanya siapa.',
  },
  {
    title: 'Ingin Mendukung Tumbuh Kembang',
    description: 'Bunda ingin memberikan stimulasi sesuai usia si kecil, sekaligus memahami cara perawatan sederhana di rumah.',
  },
];
const painPoints = (cmsSettings?.homepage?.painPoints && cmsSettings.homepage.painPoints.length > 0)
  ? cmsSettings.homepage.painPoints
  : defaultPainPoints;

const defaultBenefits = [
  {
    title: 'Si Kecil Lebih Rileks',
    description: 'Sentuhan lembut membantu si kecil lebih rileks menjelang waktu tidur. Saat si kecil nyaman, malam Bunda pun bisa terasa lebih tenang.',
  },
  {
    title: 'Lebih Nyaman Saat Batuk Pilek',
    description: 'Saat hidung tersumbat membuat si kecil rewel, kami membantu memberikan kenyamanan melalui sentuhan lembut dan stimulasi aroma terapi serta panduan perawatan sederhana yang aman dilakukan di rumah.',
  },
  {
    title: 'Stimulasi Tumbuh Kembang',
    description: 'Pijatan lembut yang disesuaikan dengan usia si kecil untuk mendukung gerak motorik dan tumbuh kembangnya secara alami.',
  },
  {
    title: 'Perawatan yang Lebih Personal 🧸',
    description: 'Setiap Bunda dan si kecil memiliki kebutuhan berbeda. Kami menyesuaikan treatment dengan kondisi, usia, dan respons masing-masing agar perawatan terasa lebih nyaman.',
  },
  {
    title: 'Bunda Lebih Tenang dan Percaya Diri ✨',
    description: 'Selain memberikan treatment, kami juga siap berbagi edukasi dan tips perawatan sederhana agar Bunda semakin percaya diri merawat si kecil di rumah.',
  },
];
const benefits = (cmsSettings?.homepage?.benefits && cmsSettings.homepage.benefits.length > 0)
  ? cmsSettings.homepage.benefits
  : defaultBenefits;

const defaultBookingSteps = [
  {
    title: 'Konsultasi gratis',
    description: 'Ceritakan usia dan kondisi si kecil. Bidan kami sarankan layanan yang paling sesuai.',
  },
  {
    title: 'Pilih hari dan jam',
    description: 'Kuota maksimal 5 sesi per hari. Jadwal dan area dikonfirmasi lewat WhatsApp.',
  },
  {
    title: 'Bidan datang ke rumah',
    description: 'Kami membawa semua perlengkapan. Bunda cukup menyiapkan ruang yang nyaman.',
  },
  {
    title: 'Lanjutkan di rumah',
    description: 'Bunda mendapat panduan sederhana untuk stimulasi harian.',
  },
];
const bookingSteps = (cmsSettings?.homepage?.bookingSteps && cmsSettings.homepage.bookingSteps.length > 0)
  ? cmsSettings.homepage.bookingSteps
  : defaultBookingSteps;

const cmsPromo = cmsSettings?.homepage?.promotion;
const promotion = {
  ...siteConfig.promotion,
  ...(cmsPromo?.title ? {
    title: cmsPromo.title,
    description: cmsPromo.description || siteConfig.promotion.description,
    serviceName: cmsPromo.serviceName || siteConfig.promotion.serviceName,
    price: cmsPromo.price || siteConfig.promotion.price,
    originalPrice: cmsPromo.originalPrice || siteConfig.promotion.originalPrice,
    badge: cmsPromo.badge || siteConfig.promotion.badge,
    note: cmsPromo.note || siteConfig.promotion.note,
    capacityNote: cmsPromo.capacityNote || siteConfig.promotion.capacityNote,
    refCode: cmsPromo.refCode || siteConfig.promotion.refCode,
    message: cmsPromo.message || siteConfig.promotion.message,
  } : {}),
};
---

<BaseLayout
  title="Baby Spa Homecare Surabaya & Sidoarjo"
  description="Baby massage, pijat newborn, dan pijat nifas homecare di Surabaya & Sidoarjo oleh bidan profesional. Perawatan nyaman untuk Bunda dan si kecil langsung di rumah."
  schemaType="home"
>
  <Hero siteSettings={siteSettings} />

  <section id="keluhan" class="py-16 md:py-24 bg-[#FFD9C4]/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-medium text-[#4B2E22]">
          Apakah ini yang Sedang Bunda Rasakan?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {painPoints.map((item, index) => (
          <div class="bg-white rounded-3xl border border-[#F6DCCD] p-7 shadow-sm hover:shadow-kala transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3 mb-3">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-[#FFEFE5] text-[#C2552B] font-brand font-bold text-sm border border-[#F6DCCD] flex-shrink-0">
                  0{index + 1}
                </span>
                <h3 class="font-brand font-semibold text-lg text-[#4B2E22] leading-snug">{item.title}</h3>
              </div>
              <p class="text-sm text-[#86675A] leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="manfaat" class="py-16 md:py-24 bg-white border-y border-[#F6DCCD]/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="inline-block text-xs font-bold tracking-wider text-[#C2552B] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD] mb-4">
          Solusi untuk Bunda dan Si Kecil
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-medium text-[#4B2E22] mb-3">
          Yang biasa Bunda rasakan setelah sesi
        </h2>
        <p class="text-sm sm:text-base text-[#86675A] leading-relaxed">
          Setiap sesi dirancang untuk menghadirkan pengalaman yang nyaman bagi si kecil dan ketenangan bagi Bunda.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6">
        {benefits.map((item, index) => (
          <div class={`rounded-3xl bg-[#FFF9F4] border border-[#F6DCCD] p-6 flex flex-col justify-between hover:shadow-kala transition-all duration-300 ${
            index < 3 ? 'lg:col-span-2' : 'lg:col-span-3'
          }`}>
            <div>
              <div class="flex items-center gap-3 mb-3">
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#FFD9C4] text-[#C2552B] font-bold text-xs flex-shrink-0">
                  ✓
                </span>
                <h3 class="font-brand font-semibold text-base text-[#4B2E22] leading-snug">{item.title}</h3>
              </div>
              <p class="text-sm text-[#86675A] leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="text-xs text-[#86675A] leading-relaxed text-center mt-8 max-w-2xl mx-auto bg-[#FFEFE5]/60 py-3 px-5 rounded-2xl border border-[#F6DCCD]">
        Setiap bayi memiliki respons yang berbeda terhadap pijat. Treatment Kala bertujuan mendukung relaksasi, stimulasi, dan kenyamanan si kecil, bukan menggantikan pemeriksaan atau penanganan medis.
      </p>
    </div>
  </section>

  <Testimonials
    socialProofText={siteSettings.socialProofText}
    foundedYear={siteSettings.foundedYear}
  />

  <section id="promo" class="py-14 md:py-20 bg-[#FFF9F4]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-[2rem] bg-[#A8431F] px-6 py-10 sm:px-10 md:grid md:grid-cols-[1.4fr_1fr] md:items-center md:gap-10 shadow-kala">
        <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/10" aria-hidden="true"></div>
        <div class="absolute -bottom-14 left-1/3 h-40 w-40 rounded-full bg-[#F5C24E]/10" aria-hidden="true"></div>

        <div class="relative">
          <span class="inline-block text-[11px] font-bold tracking-wider uppercase text-[#FFE3B0] bg-white/10 px-3 py-1 rounded-full">
            Penawaran Reservasi Pertama
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-white mt-4 mb-3">
            {promotion.title}
          </h2>
          <p class="text-sm sm:text-base text-white leading-relaxed">
            {promotion.description}
          </p>

          <div class="mt-5 flex flex-wrap items-baseline gap-3">
            <s class="text-lg text-white/80">{promotion.originalPrice}</s>
            <b class="font-brand text-4xl sm:text-5xl text-[#F5C24E]">{promotion.price}</b>
            <span class="text-xs font-extrabold uppercase tracking-wide text-[#3A2A00] bg-[#F5C24E] px-2.5 py-1 rounded-lg">
              {promotion.badge}
            </span>
          </div>
          <p class="text-xs text-white/90 mt-3">{promotion.note}</p>
          <p class="mt-3 inline-flex items-center gap-2 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-semibold text-[#FFE3B0]">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#F5C24E]" aria-hidden="true"></span>
            {promotion.capacityNote}
          </p>
        </div>

        <div class="relative mt-8 md:mt-0">
          <WhatsAppButton
            refCode={promotion.refCode}
            message={promotion.message}
            text="Ambil Promo via WhatsApp"
            variant="promo"
            className="w-full"
            phone={siteSettings.whatsappNumber}
          />
          <p class="text-xs text-white/90 text-center mt-3">
            {promotion.serviceName}
          </p>
        </div>
      </div>
    </div>
  </section>

  <FeaturedServices phone={siteSettings.whatsappNumber} />

  <ValueProps />

  <section id="cara-reservasi" class="py-16 md:py-24 bg-[#FFF9F4]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="inline-block text-xs font-bold tracking-wider text-[#C2552B] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD]">
          Mudah & Cepat
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-[#4B2E22] mt-4 mb-4">
          Cara reservasi homecare
        </h2>
        <p class="text-sm sm:text-base text-[#86675A] leading-relaxed">
          Selesai dalam beberapa menit lewat WhatsApp, tanpa perlu keluar rumah.
        </p>
      </div>

      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {bookingSteps.map((step, index) => (
          <li class="relative rounded-3xl bg-white border border-[#F6DCCD] p-6">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#C2552B] text-white font-brand font-bold">
              {index + 1}
            </span>
            <h3 class="font-brand font-bold text-base text-[#4B2E22] mt-4 mb-2">{step.title}</h3>
            <p class="text-sm text-[#86675A] leading-relaxed">{step.description}</p>
          </li>
        ))}
      </ol>

      <div class="text-center mt-10">
        <WhatsAppButton
          refCode="KALA-STEPS"
          message="Halo Bu Bidan, saya mau reservasi homecare. Usia bayi: ______, area/kecamatan: ______"
          text="Mulai Konsultasi Gratis"
          variant="primary"
          phone={siteSettings.whatsappNumber}
        />
      </div>
    </div>
  </section>

  <CoverageArea phone={siteSettings.whatsappNumber} />

  <section id="faq" class="py-16 md:py-24 bg-white border-y border-[#F6DCCD]/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-10 lg:gap-16">
      <div>
        <span class="inline-block text-xs font-bold tracking-wider text-[#C2552B] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD]">
          Tanya Jawab
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-[#4B2E22] mt-4 mb-4">
          Pertanyaan yang sering muncul
        </h2>
        <p class="text-sm sm:text-base text-[#86675A] leading-relaxed mb-6">
          Belum menemukan jawabannya? Bidan Kala siap membantu lewat WhatsApp pada jam operasional.
        </p>
        <WhatsAppButton
          refCode="KALA-FAQ"
          message="Halo Bu Bidan, saya mau tanya seputar layanan homecare"
          text="Tanya Langsung ke Bidan"
          variant="secondary"
          phone={siteSettings.whatsappNumber}
        />
        <p class="text-xs text-[#86675A] mt-4">Jam layanan: {siteSettings.operationalHours}</p>
      </div>

      <div class="faq space-y-3">
        {faqs.map((faq, index) => (
          <details class="group rounded-2xl border border-[#F6DCCD] bg-[#FFF9F4]" open={index === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-bold text-[#4B2E22]">
              <span>{faq.question}</span>
            </summary>
            <p class="px-5 pb-5 text-sm leading-relaxed text-[#86675A]">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-[#FFF9F4]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-[2rem] bg-[#A8431F] px-6 py-12 sm:px-12 text-center shadow-kala">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-white mb-4">
          Perawatan Nyaman untuk Bunda & Si Kecil 🤍
        </h2>
        <p class="text-sm sm:text-base text-white leading-relaxed max-w-xl mx-auto mb-8">
          Tak perlu keluar rumah untuk mendapatkan perawatan penuh perhatian. Ceritakan kebutuhan Bunda, kami bantu pilihkan treatment yang sesuai.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <WhatsAppButton
            refCode="KALA-FINAL"
            message="Halo Bu Bidan, saya mau konsultasi perawatan untuk Bunda dan si kecil"
            text="Konsultasi via WhatsApp"
            variant="promo"
            className="w-full sm:w-auto"
            phone={siteSettings.whatsappNumber}
          />
          <a
            href="/layanan"
            class="inline-flex w-full sm:w-auto items-center justify-center rounded-xl border border-white/40 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F5C24E] focus-visible:ring-offset-2 focus-visible:ring-offset-[#A8431F]"
          >
            Lihat Pilihan Treatment
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary {
    list-style: none;
  }

  .faq summary::after {
    content: '+';
    flex: none;
    font-family: 'Fredoka', 'Nunito', sans-serif;
    font-size: 1.4rem;
    line-height: 1;
    color: #C2552B;
    transition: transform 0.2s ease;
  }

  .faq details[open] summary::after {
    transform: rotate(45deg);
  }
</style>
