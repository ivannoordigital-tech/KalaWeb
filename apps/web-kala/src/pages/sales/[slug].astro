            </div>
          </div>
        </section>

        <!-- 2. PAIN POINTS SECTION -->
        {campaign.painPoints && campaign.painPoints.length > 0 && (
          <section class="py-12 md:py-16 bg-white border-b border-[#F6DCCD]">
            <div class="max-w-3xl mx-auto px-4">
              <h2 class="text-2xl sm:text-3xl font-brand font-bold text-[#4B2E22] text-center mb-8">
                Apakah Bunda Mengalami Hal Ini?
              </h2>
              <div class="space-y-4">
                {campaign.painPoints.map((point) => (
                  <div class="flex items-start gap-3 p-4 rounded-2xl bg-[#FFF9F4] border border-[#F6DCCD]">
