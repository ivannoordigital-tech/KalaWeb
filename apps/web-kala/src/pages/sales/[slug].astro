            { q: 'Usia berapa bayi sudah aman untuk baby massage?', a: 'Sejak usia beberapa hari setelah lahir (newborn) sudah sangat aman dilakukan stimulasi pijat lembut, asalkan kondisi tanda vital stabil dan tali pusat dirawat secara benar.' },
            { q: 'Apakah Bunda perlu menyiapkan peralatan khusus?', a: 'Tidak perlu repot. Bidan Kala membawa perlak steril, minyak food-grade steril tanpa pewangi sintetis, serta perlengkapan bersih. Bunda cukup sediakan pakaian ganti si kecil.' },
            { q: 'Bagaimana jika si kecil menangis saat pemijatan?', a: 'Bidan kami tidak pernah memaksakan tindakan. Kami akan memberi jeda, menenangkan si kecil dengan pelukan hangat, atau mempersilakan Bunda menyusui terlebih dahulu.' },
            { q: 'Apakah melayani seluruh area Surabaya dan Sidoarjo?', a: 'Ya, bidan kami melayani seluruh area Surabaya (Pusat, Barat, Timur, Selatan, Utara) serta wilayah Sidoarjo Kota dan sekitarnya.' },
          ],
        },
        {
          blockType: 'cta',
          badge: 'Slot Kunjungan Terbatas Setiap Hari',
          headline: 'Berikan Si Kecil Awal Terbaik dalam Hidupnya',
          description: 'Konsultasikan kebutuhan perawatan si kecil bersama Bidan Kala sekarang juga via WhatsApp.',
          buttonText: '💬 Chat WhatsApp Bidan Sekarang',
          buttonMessage: 'Halo Bu Bidan, saya mau pesan sesi Baby Massage untuk si kecil',
          footnote: '⚡ Balas cepat dalam 5 menit · Tanpa biaya konsultasi pertama',
        },
      ],
    },
  ];

  const combinedCampaigns = [...cmsCampaigns];
  for (const lp of landingFromPages) {
    if (!combinedCampaigns.some((c) => c.slug === lp.slug)) {
      combinedCampaigns.push(lp);
    }
  }
  const rawList = combinedCampaigns.length > 0 ? combinedCampaigns : fallbackCampaigns;

  const campaigns = rawList.map((c) => ({
    ...c,
    painPoints: (c.painPoints || []).map((p: any) => typeof p === 'string' ? p : p.point),
  }));

  const paths: any[] = [];
  for (const campaign of campaigns) {
    paths.push({
      params: { slug: campaign.slug },
      props: { campaign },
    });
    // Menjamin alias kebab-case tersedia jika slug camelCase
    if (campaign.slug === 'babyMassage') {
      paths.push({
        params: { slug: 'baby-massage' },
        props: { campaign },
      });
    }
  }
  return paths;
}

interface Props {
  campaign: PayloadLandingPage & {
    painPoints?: string[];
    solutions?: Array<{ title: string; desc: string }>;
    steps?: Array<{ num: string; title: string; desc: string }>;
    testimonial?: { quote: string; author: string; area: string };
    faqs?: Array<{ q: string; a: string }>;
    layout?: any[];
  };
}

const { campaign } = Astro.props;
const isCanvas = campaign.pageLayout === 'canvas';
const cmsSettings = await fetchSiteSettings();
const analyticsConfig = {
  ...siteConfig.analytics,
  ...(cmsSettings?.analytics || {}),
};
const gtmId = import.meta.env.PUBLIC_GTM_ID || 'GTM-XXXXXXX';
const metaDescription = campaign.subheadline || `${campaign.title} - Layanan perawatan dan pijat bayi homecare profesional oleh bidan bersertifikat di Surabaya dan Sidoarjo.`;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{campaign.title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={`https://kalababyspa.com/sales/${campaign.slug}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- A/B Testing & Conversion Attribution Meta -->
    <meta name="kala:lp-slug" content={campaign.slug} />
    <meta name="kala:variant" content={campaign.variant || (campaign.slug.endsWith('-b') ? 'B' : campaign.slug.endsWith('-c') ? 'C' : 'A')} />
    <meta name="kala:ref-code" content={campaign.refCode} />
    {campaign.campaignBaseRef && <meta name="kala:campaign-base-ref" content={campaign.campaignBaseRef} />}

    <!-- Centralized Analytics & Pixels (GTM, Meta, TikTok, GA4, Clarity) -->
    <AnalyticsScripts analytics={analyticsConfig} activePixels={campaign.activePixels} placement="head" />
  </head>
  <body class="bg-[#FFF9F4] text-[#4B2E22] min-h-screen flex flex-col font-sans selection:bg-[#FFD9C4] pb-20 md:pb-0">
    <!-- Centralized Analytics Noscript (GTM) -->
    <AnalyticsScripts analytics={analyticsConfig} activePixels={campaign.activePixels} placement="body" />
    
    <!-- Minimalist Header -->
    {!isCanvas && (
    <header class="py-4 px-4 bg-white/90 backdrop-blur-md border-b border-[#F6DCCD] sticky top-0 z-30">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
          <img
            src="/images/logo-icon.webp"
            alt="Logo Kala Homecare"
            width="36"
            height="36"
            class="w-9 h-9 object-contain"
          />
          <span class="font-brand font-bold text-lg text-[#4B2E22]">Kala Homecare</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="hidden sm:inline-block text-xs font-semibold text-[#0E733D] bg-[#E8F8EE] px-2.5 py-1 rounded-full border border-[#C5ECD2]">
            ✓ Bidan Bersertifikat
          </span>
          <span class="text-xs text-[#86675A] font-semibold">Surabaya & Sidoarjo</span>
        </div>
      </div>
    </header>
    )}

    {campaign.layout && campaign.layout.length > 0 ? (
      <main>
        {campaign.layout.map((block: any) => (
          <BlockRenderer block={block} />
        ))}
      </main>
    ) : (
      <>
        <!-- 1. HERO SECTION -->
        <section class="py-12 md:py-16 bg-gradient-to-b from-[#FFEFE5]/60 to-[#FFF9F4] border-b border-[#F6DCCD]">
          <div class="max-w-3xl mx-auto px-4 text-center">
            <span class="text-xs font-bold tracking-wider text-[#B3471E] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD] inline-block mb-4">
              Layanan Bidan Homecare
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-brand font-bold text-[#4B2E22] mb-4 leading-tight">
              {campaign.headline}
            </h1>
            <p class="text-base sm:text-lg text-[#86675A] leading-relaxed mb-8">
              {campaign.subheadline}
            </p>

            <!-- CTA Box -->
            <div class="bg-white p-6 sm:p-8 rounded-3xl border-2 border-[#F6DCCD] shadow-kala inline-block w-full max-w-lg mx-auto">
              <div class="flex items-center justify-center gap-4 mb-4">
                <span class="text-3xl font-brand font-bold text-[#B3471E]">{campaign.price}</span>
                <span class="text-xs text-[#86675A] bg-[#FFF9F4] px-3 py-1 rounded-full border border-[#F6DCCD]">
                  ⏱ {campaign.duration}
                </span>
              </div>
              <WhatsAppButton
                refCode={campaign.refCode}
                message={`Promo [${campaign.refCode || 'HI-21'}]\nHalo Bu Bidan, saya mau pesan sesi ${campaign.headline}`}
