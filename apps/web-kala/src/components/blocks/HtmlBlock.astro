---
import sanitizeHtml from 'sanitize-html';

interface Props {
  block: {
    label?: string;
    html?: string;
    allowScripts?: boolean;
    maxWidth?: 'narrow' | 'normal' | 'wide' | 'full';
    padding?: 'none' | 'compact' | 'normal' | 'spacious';
    background?: 'transparent' | 'white' | 'cream' | 'peach';
  };
}

const { block } = Astro.props;

const raw = String(block.html || '').trim();
const allowScripts = Boolean(block.allowScripts);
const frameId = `kala-html-${Math.random().toString(36).slice(2, 10)}`;

/**
 * Mode sandbox:
 * - iframe dengan sandbox="allow-scripts" TANPA allow-same-origin.
 * - Origin menjadi opaque: tidak bisa membaca DOM induk, cookie, localStorage,
 *   atau mengarahkan ulang halaman.
 * - CSP membatasi resource: inline script/style, gambar/media https, dan
 *   library dari jsdelivr/unpkg. Koneksi jaringan (fetch/XHR) diblokir.
 */
function buildSandboxDocument(html: string): string {
  const csp = [
    "default-src 'none'",
    "img-src https: data: blob:",
    "media-src https: data: blob:",
    "style-src 'unsafe-inline' https:",
    "script-src 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com",
    "font-src https: data:",
    "connect-src 'none'",
    "frame-src 'none'",
    "object-src 'none'",
    "base-uri 'none'",
    "form-action 'none'",
  ].join('; ');

  const heightScript = `
(function () {
  function sendHeight() {
    try {
      var height = Math.max(
        document.body ? document.body.scrollHeight : 0,
        document.documentElement ? document.documentElement.scrollHeight : 0
      );
      parent.postMessage({ type: 'kala-html-height', id: ${JSON.stringify(frameId)}, height: height }, '*');
    } catch (error) {}
  }
  window.addEventListener('load', sendHeight);
  if (window.ResizeObserver) {
    new ResizeObserver(sendHeight).observe(document.documentElement);
  } else {
    window.setInterval(sendHeight, 500);
  }
  sendHeight();
})();
`;

  return `<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta http-equiv="Content-Security-Policy" content="${csp}" />
<meta name="referrer" content="no-referrer" />
<style>
  html, body { margin: 0; padding: 0; background: transparent; }
  *, *::before, *::after { box-sizing: border-box; }
  body { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #4B2E22; }
</style>
<script>${heightScript}</script>
</head>
<body>${html}</body>
</html>`;
}

const sandboxDocument = allowScripts ? buildSandboxDocument(raw) : '';

const sanitized = !allowScripts && raw
  ? sanitizeHtml(raw, {
      allowedTags: [
        'div', 'section', 'article', 'aside', 'header', 'footer', 'main', 'nav',
        'span', 'p', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
        'ul', 'ol', 'li', 'dl', 'dt', 'dd',
        'a', 'strong', 'b', 'em', 'i', 'u', 's', 'small', 'mark',
        'br', 'hr', 'blockquote', 'pre', 'code',
        'table', 'thead', 'tbody', 'tfoot', 'tr', 'th', 'td', 'caption', 'colgroup', 'col',
        'img', 'figure', 'figcaption', 'picture', 'source',
        'video', 'audio',
      ],
      allowedAttributes: {
        '*': ['class', 'id', 'style', 'title', 'role', 'aria-*', 'data-*'],
        a: ['href', 'target', 'rel', 'name'],
        img: ['src', 'alt', 'width', 'height', 'loading', 'decoding', 'srcset', 'sizes'],
        source: ['src', 'srcset', 'type', 'media', 'sizes'],
        video: ['src', 'controls', 'poster', 'width', 'height', 'muted', 'loop', 'playsinline', 'preload'],
        audio: ['src', 'controls', 'preload', 'loop'],
        td: ['colspan', 'rowspan', 'headers'],
        th: ['colspan', 'rowspan', 'scope', 'headers'],
      },
      allowedSchemes: ['http', 'https', 'mailto', 'tel'],
      allowedSchemesByTag: {
        img: ['http', 'https'],
        source: ['http', 'https'],
      },
      allowProtocolRelative: false,
      disallowedTagsMode: 'discard',
    })
      .replace(/@import[^;]+;/gi, '')
      .replace(/expression\s*\(/gi, '')
      .replace(/javascript\s*:/gi, '')
      .replace(/behavior\s*:/gi, '')
      .replace(/-moz-binding\s*:/gi, '')
  : '';

const widthClasses: Record<string, string> = {
  narrow: 'max-w-3xl',
  normal: 'max-w-6xl',
  wide: 'max-w-7xl',
  full: 'max-w-none',
};
const paddingClasses: Record<string, string> = {
  none: '',
  compact: 'py-6 md:py-8',
  normal: 'py-10 md:py-14',
  spacious: 'py-16 md:py-24',
};
const backgroundClasses: Record<string, string> = {
  transparent: '',
  white: 'bg-white',
  cream: 'bg-[#FFF9F4]',
  peach: 'bg-[#FFEFE5]',
};
---

{(sanitized || sandboxDocument) && (
  <section class={`${paddingClasses[block.padding || 'normal'] || ''} ${backgroundClasses[block.background || 'transparent'] || ''}`}>
    <div class={`${widthClasses[block.maxWidth || 'normal'] || widthClasses.normal} mx-auto px-4 sm:px-6`}>
      {allowScripts ? (
        <iframe
          title={block.label || 'HTML kustom dengan JavaScript'}
          sandbox="allow-scripts"
          srcdoc={sandboxDocument}
          data-kala-html-frame
          data-frame-id={frameId}
          class="block w-full border-0"
          style="height: 200px;"
          loading="lazy"
          referrerpolicy="no-referrer"
        ></iframe>
      ) : (
        <div set:html={sanitized} />
      )}
    </div>
  </section>
)}

<script>
  function initKalaHtmlFrames() {
    const frames = Array.from(document.querySelectorAll<HTMLIFrameElement>('[data-kala-html-frame]'));
    if (frames.length === 0) return;

    window.addEventListener('message', (event) => {
      const data = event.data;
      if (!data || data.type !== 'kala-html-height') return;

      const frame = frames.find((item) => item.contentWindow === event.source);
      if (!frame) return;

      const height = Number(data.height);
      if (Number.isFinite(height) && height > 0) {
        frame.style.height = `${Math.ceil(height)}px`;
      }
    });
  }

  initKalaHtmlFrames();
  document.addEventListener('astro:page-load', initKalaHtmlFrames);
</script>
