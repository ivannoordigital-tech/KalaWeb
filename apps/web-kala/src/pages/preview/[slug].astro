---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import { verifyPreviewToken, fetchPreviewDraft, type PreviewTokenPayload } from '../../lib/preview';

const { slug } = Astro.params;
const token = Astro.url.searchParams.get('token');

// Security Check: Token is mandatory
if (!token) {
  return new Response('Akses pratinjau ditolak: Token tidak disertakan. Buka pratinjau melalui tombol Preview di CMS Admin.', {
    status: 401,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

const runtimeEnv = (Astro.locals as any)?.runtime?.env || import.meta.env;
const previewSecret = runtimeEnv.PREVIEW_SECRET || import.meta.env.PREVIEW_SECRET || 'kala_preview_secret_fallback_key_2026';

let tokenData: PreviewTokenPayload;
try {
  tokenData = await verifyPreviewToken(token, previewSecret);
} catch (err) {
  return new Response('Akses pratinjau ditolak: Token tanda tangan digital tidak valid atau sudah kedaluwarsa.', {
    status: 401,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

let pageData: any;
try {
  pageData = await fetchPreviewDraft(tokenData.collection || 'pages', tokenData.sub, runtimeEnv);
} catch (err) {
  return new Response(`Gagal mengambil dokumen draft dari CMS: ${(err as Error).message}`, {
    status: 502,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const title = pageData?.title || `Pratinjau Draft: ${slug}`;
const blocks = Array.isArray(pageData?.layout) ? pageData.layout : [];
const hasBlocks = blocks.length > 0;
const isCanvas = pageData?.pageLayout === 'canvas';
const isFullWidth = pageData?.pageLayout === 'full_width';
---

<BaseLayout
  title={`[PRATINJAU DRAFT] ${title}`}
  description="Mode pratinjau halaman kustom draft editor CMS."
  noindex={true}
  disableAnalytics={true}
  pageLayout={pageData?.pageLayout || 'default'}>
  <!-- Prominent Draft Preview Banner (Sticky) -->
  <aside class="bg-amber-500 text-slate-950 font-bold px-4 py-3 text-center text-xs sm:text-sm sticky top-20 z-50 flex flex-wrap items-center justify-center gap-2 shadow-md">
    <span class="bg-slate-950 text-amber-400 px-2 py-0.5 rounded text-[11px] font-mono tracking-wider uppercase">
      PRATINJAU DRAFT HALAMAN
    </span>
    <span>Perubahan teks & blok di bawah ini belum dipublikasikan ke live.</span>
    <a
      href="https://admin.kalababyspa.com/admin/collections/pages"
      target="_blank"
      rel="noopener noreferrer"
      class="underline hover:text-white transition-colors ml-2"
    >
      Kembali ke Editor CMS →
    </a>
  </aside>

  {hasBlocks ? (
      <div class={isFullWidth || isCanvas ? 'w-full' : ''}>
        {blocks.map((block: any) => (
          <BlockRenderer block={block} isPreview={true} />
        ))}
      </div>
    ) : (
      <div class="py-16 px-4 text-center max-w-2xl mx-auto">
        <h1 class="text-3xl font-brand font-bold text-[#4B2E22] mb-3">{title}</h1>
        <p class="text-sm text-[#86675A]">
          Belum ada blok yang ditambahkan ke halaman ini. Silakan tambahkan minimal satu blok di CMS.
        </p>
      </div>
    )}

  <!-- Payload CMS Side-by-Side Live Preview Message Listener -->
  <script is:inline>
    (function initPayloadLivePreview() {
      if (typeof window === 'undefined') return;
      const isInsideIframe = window.self !== window.top;
      if (isInsideIframe) {
        window.addEventListener('message', function(event) {
          if (event.data && (event.data.type === 'payload-live-preview' || event.data.type === 'payload-live-preview-ready')) {
            if (event.data.data) {
              const updated = event.data.data;
              if (updated.title) {
                document.title = '[PRATINJAU DRAFT] ' + updated.title;
              }
            }
          }
        });
        try {
          window.parent.postMessage({ type: 'payload-live-preview-ready' }, '*');
        } catch (e) {}
      }
    })();
  </script>
  <!-- Builder Canvas Inspector Overlay (Sprint 3) -->
  <script src="../../scripts/preview-inspector.js"></script>
</BaseLayout>
