---

<BaseLayout
  title="Katalog & Galeri Blok Modular (/_blocks)"
  description="Katalog visual seluruh 14 blok modular KalaWeb Page Builder untuk pengujian developer dan referensi marketing."
  noindex={true}
>
  <!-- Dev Gallery Header -->
  <div class="bg-slate-900 text-white py-8 px-4 border-b border-slate-800">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <span class="text-xs uppercase font-mono font-bold tracking-wider text-amber-400 bg-amber-400/10 px-2.5 py-1 rounded border border-amber-400/20">
            INTERNAL DEVELOPER & MARKETING CATALOG
          </span>
          <h1 class="text-2xl sm:text-3xl font-brand font-bold mt-2">
            Pustaka Galeri Blok Modular KalaWeb
          </h1>
          <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-2xl">
            Semua blok di bawah ini dirender menggunakan komponen <code>BlockRenderer.astro</code> dengan data contoh nyata. Halaman ini memiliki meta tag <code>noindex</code> dan difilter dari sitemap publik.
          </p>
        </div>

        <div class="flex items-center gap-2 text-xs">
          <span class="bg-emerald-900/60 text-emerald-400 px-3 py-1.5 rounded-lg border border-emerald-500/30 font-semibold">
            ✓ 14 Blok Siap Pakai
          </span>
          <a
            href="/docs/pedoman-landing-page.md"
            class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-3 py-1.5 rounded-lg border border-slate-700 transition-colors font-medium"
          >
            Buka Pedoman Blok →
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Render all sample blocks sequentially with debug labels -->
  <div>
    {sampleBlocks.map((block, idx) => (
      <div class="relative group">
        <div class="bg-slate-100 border-y border-slate-300 py-1.5 px-4 text-[11px] font-mono text-slate-600 flex items-center justify-between">
          <span class="font-bold text-[#B3471E]">
            #{idx + 1} — Blok: <code>{block.blockType}</code>
          </span>
          <span>Status: Aktif di BlockRenderer</span>
        </div>
        <BlockRenderer block={block as any} />
      </div>
    ))}
  </div>
</BaseLayout>
