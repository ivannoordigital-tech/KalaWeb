---
import BlockRenderer from './BlockRenderer.astro';
import { getMaxWidthClass, getPaddingClass, getStyleClasses } from './style-utils';

interface Props {
  block: {
    id?: string;
    columns?: string;
    gap?: 'sm' | 'md' | 'lg';
    reverseMobile?: boolean;
    column1?: any[];
    column2?: any[];
    column3?: any[];
    column4?: any[];
    [key: string]: any;
  };
  isPreview?: boolean;
  siteSettings?: any;
}

const { block, isPreview = false, siteSettings } = Astro.props;

const columnCount = Math.min(Math.max(Number(block?.columns) || 2, 1), 4);
const columnNames = ['column1', 'column2', 'column3', 'column4'].slice(0, columnCount);

const columns = columnNames.map((name, index) => ({
  name,
  index,
  blocks: Array.isArray(block?.[name]) ? block[name] : [],
}));

const gridClasses: Record<number, string> = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4',
};

const gapClasses: Record<string, string> = {
  sm: 'gap-3',
  md: 'gap-6',
  lg: 'gap-10',
};

const maxWidthClass = getMaxWidthClass(block);
const shellClasses = getStyleClasses(block);
const paddingClass = getPaddingClass(block);
const gridClass = gridClasses[columnCount];
const gapClass = gapClasses[block?.gap] || gapClasses.md;
const reverse = Boolean(block?.reverseMobile);
---

<section
  class={`w-full ${shellClasses} ${paddingClass}`}
  data-kala-container={block?.id}
>
  <div
    class={`mx-auto grid ${maxWidthClass === 'max-w-none' ? '' : maxWidthClass} ${gridClass} ${gapClass}`}
    style={reverse ? 'direction: rtl;' : undefined}
  >
    {columns.map((column) => (
      <div
        class="min-w-0 flex flex-col gap-4"
        style={reverse ? 'direction: ltr;' : undefined}
        data-kala-column={column.name}
      >
        {column.blocks.map((child: any) => (
          <BlockRenderer block={child} isPreview={isPreview} siteSettings={siteSettings} />
        ))}
      </div>
    ))}
  </div>
</section>
