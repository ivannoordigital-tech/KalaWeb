---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { siteConfig } from '../config/site';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Tentang Kami', url: '/tentang-kami' },
];
---

<BaseLayout
  title="Tentang Kami | Kala Moms and Baby Spa Surabaya & Sidoarjo"
  description="Mengenal Kala Moms and Baby Spa: Layanan homecare ibu dan bayi berstandar medis oleh bidan profesional ber-STR resmi di Surabaya dan Sidoarjo dengan prinsip zero mom-shaming."
  canonical={`${siteConfig.url}/tentang-kami`}
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="py-14 md:py-20 bg-gradient-to-b from-[#FFF9F4] via-[#FFEFE5]/40 to-[#FFF9F4] border-b border-[#F6DCCD]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold tracking-wider text-[#C2552B] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD] inline-block mb-4">
        Filosofi & Nilai Layanan Kala
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-brand font-bold text-[#4B2E22] mb-6 leading-tight">
        Tumbuh Berkembang Bersama Kala — Bidan Sahabat Bunda
      </h1>
      <p class="text-lg text-[#86675A] leading-relaxed max-w-2xl mx-auto">
        Kala lahir dari pemahaman mendalam bahwa masa pasca-persalinan dan merawat bayi baru lahir adalah fase yang luar biasa indah, namun sekaligus rentan rasa cemas, lelah fisik, dan keraguan bagi orang tua baru.
      </p>
    </div>
  </section>

  <!-- Core Pillars -->
  <section class="py-14 md:py-20 bg-white border-b border-[#F6DCCD]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-2xl sm:text-3xl font-brand font-bold text-[#4B2E22] mb-4">
          Tiga Komitmen Utama Kala Homecare
        </h2>
        <p class="text-sm sm:text-base text-[#86675A]">
          Setiap kunjungan ke rumah Bunda dilandasi oleh standar etika profesi kebidanan dan kehangatan manusiawi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Pillar 1 -->
        <div class="p-8 rounded-3xl bg-[#FFF9F4] border border-[#F6DCCD] flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[#FFEFE5] text-[#C2552B] font-brand font-bold text-xl flex items-center justify-center mb-6 border border-[#F6DCCD]">
              01
            </div>
            <h3 class="text-xl font-brand font-bold text-[#4B2E22] mb-3">
              100% Bidan Bersertifikat
            </h3>
            <p class="text-sm text-[#86675A] leading-relaxed">
              Bukan sekadar terapis pijat umum. Semua tenaga yang datang ke rumah Bunda adalah lulusan kebidanan berizin resmi, menguasai ilmu anatomi bayi, tanda bahaya neonatal, dan fisiologi laktasi.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-[#F6DCCD]/60 text-xs font-semibold text-[#128C4A]">
            ✓ Verifikasi Kemenkes RI
          </div>
        </div>

        <!-- Pillar 2 -->
        <div class="p-8 rounded-3xl bg-[#FFF9F4] border border-[#F6DCCD] flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[#FFEFE5] text-[#C2552B] font-brand font-bold text-xl flex items-center justify-center mb-6 border border-[#F6DCCD]">
              02
            </div>
            <h3 class="text-xl font-brand font-bold text-[#4B2E22] mb-3">
              Zero Mom-Shaming
            </h3>
            <p class="text-sm text-[#86675A] leading-relaxed">
              Kami percaya tidak ada Bunda yang sempurna, yang ada hanyalah Bunda yang selalu berusaha memberikan yang terbaik. Kami hadir untuk memvalidasi rasa lelah, bukan menghakimi pilihan menyusui atau pola asuh.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-[#F6DCCD]/60 text-xs font-semibold text-[#C2552B]">
            ✓ Ruang Aman & Nyaman
          </div>
        </div>

        <!-- Pillar 3 -->
        <div class="p-8 rounded-3xl bg-[#FFF9F4] border border-[#F6DCCD] flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[#FFEFE5] text-[#C2552B] font-brand font-bold text-xl flex items-center justify-center mb-6 border border-[#F6DCCD]">
              03
            </div>
            <h3 class="text-xl font-brand font-bold text-[#4B2E22] mb-3">
              Higienitas Medis Ketat
            </h3>
            <p class="text-sm text-[#86675A] leading-relaxed">
              Kulit bayi baru lahir sangat sensitif. Kala menggunakan linen steril sekali pakai, sterilisasi alat sebelum tindakan, dan minyak murni food-grade tanpa pewangi sintetik yang aman jika tertelan.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-[#F6DCCD]/60 text-xs font-semibold text-[#128C4A]">
            ✓ Minyak Food-Grade Alami
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Box -->
  <section class="py-14 md:py-20 bg-[#FFF9F4]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl p-8 sm:p-12 border-2 border-[#F6DCCD] shadow-kala text-center">
        <h2 class="text-2xl sm:text-3xl font-brand font-bold text-[#4B2E22] mb-4">
          Siap Merasakan Perawatan Hangat Bersama Bidan Kala?
        </h2>
        <p class="text-sm sm:text-base text-[#86675A] max-w-xl mx-auto mb-8 leading-relaxed">
          Konsultasikan kebutuhan Bunda dan si kecil hari ini. Tim kami melayani area Surabaya dan Sidoarjo setiap hari.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <WhatsAppButton
            refCode="KALA-ABOUT"
            message="Halo Bidan Kala, saya membaca halaman Tentang Kami dan ingin konsultasi jadwal homecare [ref: KALA-ABOUT]"
            text="Hubungi Bidan Kala Sekarang"
            variant="hero"
          />
          <a
            href="/tim-bidan"
            class="px-6 py-3.5 rounded-full border border-[#C2552B] text-[#C2552B] font-bold text-sm hover:bg-[#FFEFE5] transition-colors"
          >
            Lihat Profil Tim Bidan →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
