                    <p class="text-sm sm:text-base text-[#4B2E22] font-medium leading-relaxed">
                      {point}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )}

        <!-- 3. SOLUTIONS & WHY KALA -->
        {campaign.solutions && campaign.solutions.length > 0 && (
          <section class="py-12 md:py-16 bg-[#FFF9F4] border-b border-[#F6DCCD]">
            <div class="max-w-3xl mx-auto px-4">
              <h2 class="text-2xl sm:text-3xl font-brand font-bold text-[#4B2E22] text-center mb-8">
                Solusi Medis & Penuh Kehangatan dari Kala
