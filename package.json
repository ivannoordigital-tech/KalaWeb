{
  "name": "kala-web-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Kala Moms and Baby Spa digital platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web-kala",
    "dev:cms": "npm run dev --workspace=cms-kala",
    "convert:images": "node scripts/convert-webp.mjs",
    "build": "npm run build --workspace=web-kala",
    "build:cms": "npm run build --workspace=cms-kala",
    "audit:seo": "node scripts/audit-seo.mjs",
    "preview": "npm run preview --workspace=web-kala"
  }
}
