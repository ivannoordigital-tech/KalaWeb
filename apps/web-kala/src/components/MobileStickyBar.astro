---
import { siteConfig } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  phone?: string;
  refCode?: string;
  priceNote?: string;
}

const {
  phone = siteConfig.whatsappNumber,
  refCode = 'KALA-MOB-BAR',
  priceNote = `Mulai ${siteConfig.promotion.price}`,
} = Astro.props;
---

<div
  id="mobile-sticky-bar"
  class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-[#F6DCCD] px-4 py-2.5 shadow-[0_-4px_20px_rgba(75,46,34,0.08)] transition-all duration-300 ease-in-out transform translate-y-full opacity-0 pointer-events-none"
  style="padding-bottom: max(0.6rem, env(safe-area-inset-bottom));"
>
  <div class="max-w-md mx-auto flex items-center justify-center">
    <WhatsAppButton
      refCode={refCode}
      phone={phone}
      text="Konsultasi Sekarang"
      variant="primary"
      className="w-full text-center text-sm py-3 px-6 min-h-[46px] shadow-sm flex items-center justify-center font-bold"
    />
  </div>
</div>

<script is:inline>
  (function () {
    function setupStickyScroll() {
      var mobileBar = document.getElementById('mobile-sticky-bar');
      var desktopFloating = document.getElementById('desktop-floating-wa');
      if (!mobileBar && !desktopFloating) return;

      var isMobileVisible = false;
      var isDesktopVisible = false;
      var ticking = false;

      function checkScroll() {
        var doc = document.documentElement;
        var total = doc.scrollHeight - window.innerHeight;
        var scrollPercent = total > 0 ? (window.scrollY / total) * 100 : 0;

        // Mobile: 10%, Desktop: 20%
        var shouldShowMobile = scrollPercent >= 10;
        var shouldShowDesktop = scrollPercent >= 20;

        if (mobileBar && shouldShowMobile !== isMobileVisible) {
          isMobileVisible = shouldShowMobile;
          if (isMobileVisible) {
            mobileBar.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
            mobileBar.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
          } else {
            mobileBar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
            mobileBar.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
          }
        }

        if (desktopFloating && shouldShowDesktop !== isDesktopVisible) {
          isDesktopVisible = shouldShowDesktop;
          if (isDesktopVisible) {
            desktopFloating.classList.remove('translate-y-6', 'opacity-0', 'pointer-events-none');
            desktopFloating.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
          } else {
            desktopFloating.classList.add('translate-y-6', 'opacity-0', 'pointer-events-none');
            desktopFloating.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
          }
        }

        ticking = false;
      }

      window.addEventListener('scroll', function () {
        if (!ticking) {
          window.requestAnimationFrame(checkScroll);
          ticking = true;
        }
      }, { passive: true });

      checkScroll();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupStickyScroll);
    } else {
      setupStickyScroll();
    }
  })();
</script>
