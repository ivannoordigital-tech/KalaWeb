---
interface TestimonialItem {
  quote: string;
  author: string;
  role?: string;
  area?: string;
}

interface Props {
  block: {
    title: string;
    subtitle?: string;
    items: TestimonialItem[];
  };
}

const { block } = Astro.props;
const items = block.items || [];
---

<section class="py-14 md:py-20 bg-[#FFF9F4] border-b border-[#F6DCCD]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Header -->
    <div class="text-center mb-12">
      <span class="text-xs font-bold tracking-wider text-[#B3471E] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD] inline-block mb-3">
        Cerita Nyata Bunda
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-[#4B2E22] mb-3">
        {block.title}
      </h2>
      {block.subtitle && (
        <p class="text-sm sm:text-base text-[#86675A] max-w-xl mx-auto">
          {block.subtitle}
        </p>
      )}
    </div>

    <!-- Testimonials Grid -->
    <div class={`grid gap-6 ${items.length === 1 ? 'max-w-2xl mx-auto grid-cols-1' : items.length === 2 ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'}`}>
      {items.map((item) => (
        <div class="p-6 sm:p-7 rounded-3xl bg-white border border-[#F6DCCD] shadow-xs flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="flex items-center gap-1 text-[#E5A83B] mb-4 text-sm" aria-label="Rating 5 bintang">
              ★★★★★
            </div>
            <p class="text-sm sm:text-base text-[#4B2E22] leading-relaxed italic mb-6">
              “{item.quote}”
            </p>
          </div>
          <div class="pt-4 border-t border-[#F6DCCD]/60 flex items-center justify-between">
            <div>
              <h4 class="font-bold text-[#4B2E22] text-sm">
                {item.author}
              </h4>
              {item.role && (
                <span class="text-xs text-[#86675A] block">
                  {item.role}
                </span>
              )}
            </div>
            {item.area && (
              <span class="text-xs font-semibold text-[#B3471E] bg-[#FFEFE5] px-2.5 py-1 rounded-full border border-[#F6DCCD]">
                📍 {item.area}
              </span>
            )}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
