---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeaturedServices from '../components/FeaturedServices.astro';
import ValueProps from '../components/ValueProps.astro';
import Testimonials from '../components/Testimonials.astro';
import CoverageArea from '../components/CoverageArea.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { fetchSiteSettings, fetchPayloadFAQs } from '../lib/payload';
import { siteConfig } from '../config/site';

const cmsSettings = await fetchSiteSettings();
const siteSettings = {
  ...siteConfig,
  whatsappNumber: cmsSettings?.whatsappNumber || siteConfig.whatsappNumber,
  whatsappNumberFormatted: cmsSettings?.whatsappNumberFormatted || siteConfig.whatsappNumberFormatted,
  instagram: cmsSettings?.instagram || siteConfig.instagram,
  operationalHours: cmsSettings?.operationalHours || siteConfig.operationalHours,
  socialProofText: cmsSettings?.socialProofText || siteConfig.socialProofText,
  heroBadgeText: cmsSettings?.heroBadgeText || '✨ Bidan Resmi Ber-STR',
};

const cmsFaqs = await fetchPayloadFAQs();
const capacityFaq = siteConfig.faqs.find(
  (faq) => faq.question === 'Berapa sesi yang bisa dijadwalkan setiap hari?'
);
const faqs = cmsFaqs.length > 0
  ? [
      ...cmsFaqs.map((item) => ({ question: item.question, answer: item.answer })),
      ...(capacityFaq && !cmsFaqs.some((item) => item.question === capacityFaq.question)
        ? [capacityFaq]
        : []),
    ]
  : siteConfig.faqs;

const painPoints = [
  {
    title: 'Bayi rewel dan susah tidur',
    description: 'Menangis tanpa sebab yang jelas, malam jadi panjang, Bunda dan Papa kelelahan.',
  },
  {
    title: 'Perut kembung dan gelisah',
    description: 'Menarik kaki ke perut sambil menangis. Bunda ingin membantu tapi bingung harus mulai dari mana.',
  },
  {
    title: 'Bingung soal stimulasi',
    description: 'Informasi di internet banyak dan saling bertentangan. Bunda ingin tahu yang aman untuk usia si kecil.',
  },
];

const benefits = [
  {
    title: 'Lebih rileks menjelang tidur',
    description: 'Banyak orang tua melaporkan bayi tampak lebih tenang setelah dipijat.',
  },
  {
    title: 'Perut lebih nyaman',
    description: 'Teknik pijat perut lembut untuk membantu bayi yang sering kembung.',
  },
  {
    title: 'Stimulasi sesuai usia',
    description: 'Gerakan disesuaikan tahap tumbuh kembang, plus panduan lanjutan di rumah.',
  },
  {
    title: 'Bonding Bunda dan bayi',
    description: 'Bunda bisa ikut belajar sentuhan yang menenangkan.',
  },
];

const bookingSteps = [
  {
    title: 'Konsultasi gratis',
    description: 'Ceritakan usia dan kondisi si kecil. Bidan kami sarankan layanan yang paling sesuai.',
  },
  {
    title: 'Pilih hari dan jam',
    description: 'Kuota maksimal 5 sesi per hari. Jadwal dan area dikonfirmasi lewat WhatsApp.',
  },
  {
    title: 'Bidan datang ke rumah',
    description: 'Kami membawa semua perlengkapan. Bunda cukup menyiapkan ruang yang nyaman.',
  },
  {
    title: 'Lanjutkan di rumah',
    description: 'Bunda mendapat panduan sederhana untuk stimulasi harian.',
  },
];
---

<BaseLayout
  title="Baby Spa Homecare Surabaya & Sidoarjo"
  description="Baby massage, pijat newborn, dan pijat nifas homecare di Surabaya & Sidoarjo oleh bidan ber-STR. Konsultasi gratis via WhatsApp."
  schemaType="home"
>
  <Hero siteSettings={siteSettings} />

  <section id="keluhan" class="py-16 md:py-24 bg-[#FFD9C4]/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="inline-block text-xs font-bold tracking-wider text-[#C2552B] uppercase bg-white px-3.5 py-1.5 rounded-full border border-[#F6DCCD]">
          Kenali Kebutuhannya
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-[#4B2E22] mt-4 mb-4">
          Apakah ini yang sedang Bunda alami?
        </h2>
        <p class="text-sm sm:text-base text-[#86675A] leading-relaxed">
          Bunda tidak perlu menghadapinya sendiri. Bidan Kala datang ke rumah untuk membantu dengan pendekatan yang tenang dan sesuai usia bayi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {painPoints.map((item) => (
          <div class="bg-white rounded-3xl border border-[#F6DCCD] p-7 shadow-sm">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#FFEFE5] text-[#C2552B] font-brand font-bold">
              !
            </span>
            <h3 class="font-brand font-bold text-lg text-[#4B2E22] mt-4 mb-2">{item.title}</h3>
            <p class="text-sm text-[#86675A] leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="manfaat" class="py-16 md:py-24 bg-white border-y border-[#F6DCCD]/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="inline-block text-xs font-bold tracking-wider text-[#C2552B] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD]">
          Setelah Sesi
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-[#4B2E22] mt-4 mb-4">
          Yang biasa Bunda rasakan setelah sesi
        </h2>
        <p class="text-sm sm:text-base text-[#86675A] leading-relaxed">
          Sentuhan yang tepat dan lembut membantu bayi lebih nyaman. Hasil tiap bayi bisa berbeda.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {benefits.map((item) => (
          <div class="rounded-3xl bg-[#FFF9F4] border border-[#F6DCCD] p-6">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-[#FFD9C4] text-[#C2552B] font-bold">
              ✓
            </span>
            <h3 class="font-brand font-bold text-base text-[#4B2E22] mt-4 mb-2">{item.title}</h3>
            <p class="text-sm text-[#86675A] leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>

      <p class="text-xs text-[#86675A] leading-relaxed text-center mt-8 max-w-2xl mx-auto">
        Pijat bayi bersifat pendukung kenyamanan, bukan pengganti pemeriksaan dokter.
      </p>
    </div>
  </section>

  <section id="promo" class="py-14 md:py-20 bg-[#FFF9F4]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-[2rem] bg-[#A8431F] px-6 py-10 sm:px-10 md:grid md:grid-cols-[1.4fr_1fr] md:items-center md:gap-10 shadow-kala">
        <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/10" aria-hidden="true"></div>
        <div class="absolute -bottom-14 left-1/3 h-40 w-40 rounded-full bg-[#F5C24E]/10" aria-hidden="true"></div>

        <div class="relative">
          <span class="inline-block text-[11px] font-bold tracking-wider uppercase text-[#FFE3B0] bg-white/10 px-3 py-1 rounded-full">
            Penawaran Reservasi Pertama
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-white mt-4 mb-3">
            {siteConfig.promotion.title}
          </h2>
          <p class="text-sm sm:text-base text-white leading-relaxed">
            {siteConfig.promotion.description}
          </p>

          <div class="mt-5 flex flex-wrap items-baseline gap-3">
            <s class="text-lg text-white/80">{siteConfig.promotion.originalPrice}</s>
            <b class="font-brand text-4xl sm:text-5xl text-[#F5C24E]">{siteConfig.promotion.price}</b>
            <span class="text-xs font-extrabold uppercase tracking-wide text-[#3A2A00] bg-[#F5C24E] px-2.5 py-1 rounded-lg">
              {siteConfig.promotion.badge}
            </span>
          </div>
          <p class="text-xs text-white/90 mt-3">{siteConfig.promotion.note}</p>
          <p class="mt-3 inline-flex items-center gap-2 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-semibold text-[#FFE3B0]">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#F5C24E]" aria-hidden="true"></span>
            {siteConfig.promotion.capacityNote}
          </p>
        </div>

        <div class="relative mt-8 md:mt-0">
          <WhatsAppButton
            refCode={siteConfig.promotion.refCode}
            message={siteConfig.promotion.message}
            text="Ambil Promo via WhatsApp"
            variant="promo"
            className="w-full"
            phone={siteSettings.whatsappNumber}
          />
          <p class="text-xs text-white/90 text-center mt-3">
            {siteConfig.promotion.serviceName}
          </p>
        </div>
      </div>
    </div>
  </section>

  <FeaturedServices phone={siteSettings.whatsappNumber} />

  <ValueProps />

  <section id="cara-reservasi" class="py-16 md:py-24 bg-[#FFF9F4]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="inline-block text-xs font-bold tracking-wider text-[#C2552B] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD]">
          Mudah & Cepat
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-[#4B2E22] mt-4 mb-4">
          Cara reservasi homecare
        </h2>
        <p class="text-sm sm:text-base text-[#86675A] leading-relaxed">
          Selesai dalam beberapa menit lewat WhatsApp, tanpa perlu keluar rumah.
        </p>
      </div>

      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {bookingSteps.map((step, index) => (
          <li class="relative rounded-3xl bg-white border border-[#F6DCCD] p-6">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#C2552B] text-white font-brand font-bold">
              {index + 1}
            </span>
            <h3 class="font-brand font-bold text-base text-[#4B2E22] mt-4 mb-2">{step.title}</h3>
            <p class="text-sm text-[#86675A] leading-relaxed">{step.description}</p>
          </li>
        ))}
      </ol>

      <div class="text-center mt-10">
        <WhatsAppButton
          refCode="KALA-STEPS"
          message="Halo Bidan Kala, saya mau reservasi homecare. Usia bayi: ______, area/kecamatan: ______ [ref: KALA-STEPS]"
          text="Mulai Konsultasi Gratis"
          variant="primary"
          phone={siteSettings.whatsappNumber}
        />
      </div>
    </div>
  </section>

  <Testimonials
    socialProofText={siteSettings.socialProofText}
    foundedYear={siteSettings.foundedYear}
  />

  <CoverageArea phone={siteSettings.whatsappNumber} />

  <section id="faq" class="py-16 md:py-24 bg-white border-y border-[#F6DCCD]/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-10 lg:gap-16">
      <div>
        <span class="inline-block text-xs font-bold tracking-wider text-[#C2552B] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD]">
          Tanya Jawab
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-[#4B2E22] mt-4 mb-4">
          Pertanyaan yang sering muncul
        </h2>
        <p class="text-sm sm:text-base text-[#86675A] leading-relaxed mb-6">
          Belum menemukan jawabannya? Bidan Kala siap membantu lewat WhatsApp pada jam operasional.
        </p>
        <WhatsAppButton
          refCode="KALA-FAQ"
          message="Halo Bidan Kala, saya mau tanya seputar layanan homecare [ref: KALA-FAQ]"
          text="Tanya Langsung ke Bidan"
          variant="secondary"
          phone={siteSettings.whatsappNumber}
        />
        <p class="text-xs text-[#86675A] mt-4">Jam layanan: {siteSettings.operationalHours}</p>
      </div>

      <div class="faq space-y-3">
        {faqs.map((faq, index) => (
          <details class="group rounded-2xl border border-[#F6DCCD] bg-[#FFF9F4]" open={index === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-bold text-[#4B2E22]">
              <span>{faq.question}</span>
            </summary>
            <p class="px-5 pb-5 text-sm leading-relaxed text-[#86675A]">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-[#FFF9F4]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-[2rem] bg-[#A8431F] px-6 py-12 sm:px-12 text-center shadow-kala">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-white mb-4">
          Beri si kecil awal yang nyaman
        </h2>
        <p class="text-sm sm:text-base text-white leading-relaxed max-w-xl mx-auto mb-8">
          Chat sekarang untuk konsultasi gratis. Bidan Kala bantu pilih layanan yang tepat untuk usia dan kebutuhan si kecil.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <WhatsAppButton
            refCode="KALA-FINAL"
            message="Halo Bidan Kala, saya mau reservasi homecare. Usia bayi: ______, area/kecamatan: ______ [ref: KALA-FINAL]"
            text="Chat WhatsApp Sekarang"
            variant="promo"
            className="w-full sm:w-auto"
            phone={siteSettings.whatsappNumber}
          />
          <a
            href="/layanan"
            class="inline-flex w-full sm:w-auto items-center justify-center rounded-xl border border-white/40 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F5C24E] focus-visible:ring-offset-2 focus-visible:ring-offset-[#A8431F]"
          >
            Lihat Semua Layanan
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary {
    list-style: none;
  }

  .faq summary::after {
    content: '+';
    flex: none;
    font-family: 'Fredoka', 'Nunito', sans-serif;
    font-size: 1.4rem;
    line-height: 1;
    color: #C2552B;
    transition: transform 0.2s ease;
  }

  .faq details[open] summary::after {
    transform: rotate(45deg);
  }
</style>
