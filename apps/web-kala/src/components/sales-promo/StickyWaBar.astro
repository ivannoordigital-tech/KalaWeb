---
interface Props {
  text?: string;
  ctaUrl?: string;
}

const {
  text = "Konsultasi Sekarang",
  ctaUrl = "https://app.kalababyspa.online/cta?divisi=iklan-utama",
} = Astro.props;
---

<div id="button-wa-container">
  <a
    href={ctaUrl}
    class="btn-wa-main"
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="icon-svg">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
      </svg>
    </span>
    {text}
  </a>
</div>

<style>
  #button-wa-container {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: #fdf8f2;
    padding: 10px 16px;
    padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
    z-index: 9999;
    display: flex;
    justify-content: center;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
  }

  .btn-wa-main {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #3d2516;
    color: #ffffff !important;
    padding: 10px 36px;
    border-radius: 50px;
    text-decoration: none !important;
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-weight: 700;
    font-size: 16px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    transition: all 0.3s ease;
    animation: shake-center 5s infinite;
  }

  .btn-wa-main:hover {
    background: #2b1a10;
    transform: scale(1.03);
  }

  .icon-svg {
    margin-right: 10px;
    display: flex;
    align-items: center;
  }

  @keyframes shake-center {
    0%, 90%, 100% { transform: translateX(0); }
    92% { transform: translateX(-4px); }
    94% { transform: translateX(4px); }
    96% { transform: translateX(-4px); }
    98% { transform: translateX(4px); }
  }
</style>
