{
  "name": "cms-kala",
  "version": "1.0.0",
  "description": "Payload CMS for Kala Moms and Baby Spa",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3005",
    "predev": "npm run build --workspace=automation-kala",
    "prebuild": "npm run build --workspace=automation-kala",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3005",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/seed.ts",
    "seed:homepage": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/seed-homepage.ts",
    "seed:homepage:force": "cross-env OVERWRITE=true NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/seed-homepage.ts",
    "import:articles": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/import-articles.ts",
    "migrate:landing": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/migrate-landing-pages.ts",
    "set:superadmin": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/set-superadmin.ts",
    "audit:backfill": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/audit-backfill.ts",
    "test:role": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/test-role-access.ts",
    "test:uiux": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/test-uiux-fixes.ts",
    "test:validation": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/test-validation.ts",
    "test:integration": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/scripts/test-integration.ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "check:parity": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/check-builder-parity.ts",
    "sync:builder": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/sync-builder-registry.ts && npm run check:parity"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "^3.91.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.10.0",
    "jose": "^5.10.0",
    "lucide-react": "^1.66.0",
    "next": "15.4.11",
    "payload": "3.91.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "sass": "^1.77.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "yaml": "^2.9.1"
  }
}
