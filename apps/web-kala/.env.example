# URL CMS Payload (Backend VPS)
PAYLOAD_URL=https://admin.kalababyspa.com

# Container ID Google Tag Manager (GTM)
PUBLIC_GTM_ID=GTM-XXXXXXX

# Fallback Mode Behavior:
# 'true': (Default di local dev) Memperbolehkan fallback ke data lokal site.ts jika CMS offline.
# 'false': (Set di Cloudflare Pages Dashboard Production) Build AKAN GAGAL jika CMS tidak terjangkau,
#          sehingga Cloudflare Pages otomatis mempertahankan deployment live sebelumnya (zero downtime).
ALLOW_FALLBACK=true
