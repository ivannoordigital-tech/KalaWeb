---
import { siteConfig } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  siteSettings?: {
    socialProofText?: string;
    heroBadgeText?: string;
    whatsappNumber?: string;
    foundedYear?: number;
    [key: string]: any;
  };
}

const { siteSettings } = Astro.props;
const heroBadge = siteSettings?.heroBadgeText || 'Dipercaya 1000+ Orang Tua di Surabaya & Sidoarjo';
const heroHeadline = siteSettings?.homepage?.heroHeadline || 'Perawatan Ibu & Bayi di Rumah oleh Bidan Profesional';
const heroTagline = siteSettings?.homepage?.heroTagline || 'Bunda Juga Berhak Dirawat dan Ditemani 🤍';
const heroDescription = siteSettings?.homepage?.heroDescription || 'Menjadi ibu penuh kebahagiaan, tetapi terkadang juga melelahkan. Kala hadir langsung ke rumah untuk membantu Bunda merawat diri dan si kecil, dengan sentuhan lembut serta pendampingan yang hangat.';
const capacityPerDay = siteConfig.promotion.capacityPerDay;
const phone = siteSettings?.whatsappNumber || siteConfig.whatsappNumber;
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden bg-gradient-to-b from-[#FFF9F4] via-[#FFEFE5]/40 to-[#FFF9F4]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text Column (Left) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#FFEFE5] border border-[#F6DCCD] text-[#C2552B] font-semibold text-xs sm:text-sm mb-6 shadow-sm">
          <span class="inline-block w-2 h-2 rounded-full bg-[#128C4A] animate-pulse"></span>
          <span>{heroBadge}</span>
        </div>

        <!-- Single H1 Title -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-brand font-medium text-[#4B2E22] tracking-tight leading-[1.18] mb-5">
          {heroHeadline}
        </h1>

        <!-- Tagline / Subtitle -->
        <p class="text-lg sm:text-xl font-medium text-[#C2552B] mb-4 font-brand">
          {heroTagline}
        </p>

        <!-- Descriptive Paragraph -->
        <p class="text-base sm:text-lg text-[#86675A] leading-relaxed mb-8 max-w-2xl">
          {heroDescription}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
          <WhatsAppButton
            refCode="KALA-HOME"
            message="Halo Bidan Kala, saya mau konsultasi homecare untuk ibu dan bayi [ref: KALA-HOME]"
            text="Konsultasi via WhatsApp"
            variant="primary"
            className="text-base py-4 px-8"
            phone={phone}
          />
          <a
            href="#layanan"
            class="inline-flex min-h-[52px] items-center justify-center rounded-full border-2 border-[#C2552B] bg-white px-6 py-3.5 text-center text-sm font-semibold text-[#A8431F] transition-all hover:bg-[#FFEFE5] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#C2552B] focus-visible:ring-offset-2 sm:text-base"
          >
            Lihat Pilihan Treatment
          </a>
        </div>

        <!-- Trust Badges Under Hero -->
        <div class="mt-8 pt-6 border-t border-[#F6DCCD]/80 grid grid-cols-3 gap-4 w-full text-center">
          <div class="flex flex-col items-center text-center gap-2">
            <div class="w-9 h-9 rounded-xl bg-[#FFEFE5] text-[#C2552B] flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
              </svg>
            </div>
            <span class="font-brand font-medium text-sm sm:text-base text-[#4B2E22]">Bidan Bersertifikat</span>
          </div>
          <div class="flex flex-col items-center text-center gap-2">
            <div class="w-9 h-9 rounded-xl bg-[#FFEFE5] text-[#C2552B] flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
              </svg>
            </div>
            <span class="font-brand font-medium text-sm sm:text-base text-[#4B2E22]">Personal</span>
          </div>
          <div class="flex flex-col items-center text-center gap-2">
            <div class="w-9 h-9 rounded-xl bg-[#FFEFE5] text-[#C2552B] flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
              </svg>
            </div>
            <span class="font-brand font-medium text-sm sm:text-base text-[#4B2E22]">Homecare</span>
          </div>
        </div>
      </div>

      <!-- Visual Card / Graphic Column (Right) -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Background Glow -->
          <div class="absolute -top-6 -left-6 w-72 h-72 bg-[#FFD9C4] rounded-full filter blur-3xl opacity-60 pointer-events-none"></div>
          <div class="absolute -bottom-6 -right-6 w-72 h-72 bg-[#FFEFE5] rounded-full filter blur-3xl opacity-70 pointer-events-none"></div>

          <!-- Feature Card Illustration -->
          <div class="relative bg-white border-2 border-[#F6DCCD] rounded-3xl p-6 sm:p-8 shadow-kala text-[#4B2E22]">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-[#F6DCCD]/60">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-[#FFEFE5] flex items-center justify-center text-[#C2552B] font-bold text-xl">
                  👶
                </div>
                <div>
                  <h2 class="font-brand font-bold text-base text-[#4B2E22] leading-tight">Layanan Homecare Kala</h2>
                  <p class="text-xs text-[#86675A]">Kenyamanan Maksimal di Rumah</p>
                </div>
              </div>
              <span class="text-xs font-bold px-3 py-1 bg-[#128C4A]/10 text-[#128C4A] rounded-full">Bidan Bersertifikat</span>
            </div>

            <ul class="space-y-4 text-sm text-[#4B2E22]">
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-[#FFD9C4] text-[#C2552B] flex items-center justify-center text-xs flex-shrink-0 mt-0.5 font-bold">✓</span>
                <div>
                  <span class="font-bold text-[#4B2E22]">Bidan Profesional:</span>
                  <span class="text-[#86675A]"> Perawatan oleh tenaga kesehatan terlatih.</span>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-[#FFD9C4] text-[#C2552B] flex items-center justify-center text-xs flex-shrink-0 mt-0.5 font-bold">✓</span>
                <div>
                  <span class="font-bold text-[#4B2E22]">Untuk Ibu & Si Kecil:</span>
                  <span class="text-[#86675A]"> Beragam treatment dalam satu kunjungan.</span>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-[#FFD9C4] text-[#C2552B] flex items-center justify-center text-xs flex-shrink-0 mt-0.5 font-bold">✓</span>
                <div>
                  <span class="font-bold text-[#4B2E22]">Nyaman di Rumah:</span>
                  <span class="text-[#86675A]"> Tanpa repot bepergian atau macet.</span>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-[#FFD9C4] text-[#C2552B] flex items-center justify-center text-xs flex-shrink-0 mt-0.5 font-bold">✓</span>
                <div>
                  <span class="font-bold text-[#4B2E22]">Perawatan Personal:</span>
                  <span class="text-[#86675A]"> Disesuaikan dengan kebutuhan Bunda dan si kecil.</span>
                </div>
              </li>
            </ul>

            <div class="mt-6 pt-4 border-t border-[#F6DCCD]/60 bg-[#FFF9F4] -mx-6 -mb-6 px-6 py-4 rounded-b-3xl">
              <div class="flex items-center justify-between gap-2 text-xs text-[#86675A]">
                <span>Konsultasi awal & tanya jadwal:</span>
                <span class="whitespace-nowrap font-bold text-[#128C4A]">Maks {capacityPerDay} sesi/hari</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
