---
import { siteConfig } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';
import { fetchPayloadServices } from '../lib/payload';

interface Props {
  phone?: string;
}

const { phone = siteConfig.whatsappNumber } = Astro.props;

const cmsServices = await fetchPayloadServices();
const servicesList = cmsServices.length > 0
  ? cmsServices.slice(0, 3).map((s) => ({
      id: s.slug || s.id,
      name: s.name,
      target: s.target,
      duration: s.duration,
      originalPrice: s.originalPrice,
      price: s.price,
      description: s.shortDescription || s.description,
      badge: s.badge,
      popular: s.recommended || s.popular,
      refCode: s.refCode,
      message: s.message || `Halo Bidan Kala, saya mau reservasi ${s.name} ${s.price} [ref: ${s.refCode}]`,
    }))
  : siteConfig.featuredServices;
---

<section id="layanan" class="py-16 md:py-24 bg-[#FFF9F4]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs font-bold tracking-wider text-[#C2552B] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD]">
        Menu Layanan Terfavorit
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-[#4B2E22] mt-4 mb-4">
        3 Layanan Unggulan Homecare Kala
      </h2>
      <p class="text-sm sm:text-base text-[#86675A] leading-relaxed">
        Pilihan paling banyak dipesan oleh Bunda di Surabaya & Sidoarjo untuk memulihkan kebugaran ibu dan menstimulasi keceriaan si kecil.
      </p>
    </div>

    <!-- Service Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-14">
      {servicesList.map((service) => (
        <div class={`relative rounded-3xl border-2 transition-all duration-300 flex flex-col justify-between overflow-hidden bg-white ${
          service.popular 
            ? 'border-[#C2552B] shadow-kala-hover md:-translate-y-2' 
            : 'border-[#F6DCCD] shadow-kala hover:shadow-kala-hover'
        }`}>
          {service.popular && (
            <div class="bg-[#C2552B] text-white text-xs font-bold py-1.5 px-4 text-center tracking-wide uppercase">
              ★ Rekomendasi Terfavorit
            </div>
          )}
          
          <div class="p-7">
            <div class="flex items-center justify-between text-xs font-semibold text-[#86675A] mb-3">
              <span class="px-2.5 py-1 bg-[#FFEFE5] text-[#C2552B] rounded-lg border border-[#F6DCCD]">
                {service.target}
              </span>
              <span class="flex items-center gap-1">
                ⏱ {service.duration}
              </span>
            </div>

            <h3 class="font-brand font-bold text-xl text-[#4B2E22] mb-3 leading-snug">
              <a href={`/layanan/${service.id}`} class="hover:text-[#C2552B] transition-colors">
                {service.name}
              </a>
            </h3>

            <p class="text-sm text-[#86675A] leading-relaxed mb-6">
              {service.description}
            </p>

            <div class="pt-4 border-t border-[#F6DCCD]/60 mb-6">
              <div class="text-xs text-[#86675A] line-through">
                {service.originalPrice}
              </div>
              <div class="flex items-baseline gap-1.5">
                <span class="text-2xl sm:text-3xl font-brand font-bold text-[#C2552B]">
                  {service.price}
                </span>
                <span class="text-xs font-semibold text-[#86675A]">/ sesi</span>
              </div>
            </div>
          </div>

          <div class="p-7 pt-0 space-y-3">
            <a
              href={`/layanan/${service.id}`}
              class="block text-center text-xs font-bold text-[#C2552B] hover:underline py-1"
            >
              Detail Prosedur & Manfaat Medis →
            </a>
            <WhatsAppButton
              refCode={service.refCode}
              message={service.message}
              text="Reservasi Layanan Ini"
              variant={service.popular ? 'primary' : 'card'}
              phone={phone}
            />
          </div>
        </div>
      ))}
    </div>

    <!-- WhatsApp Full Catalog Callout -->
    <div class="bg-gradient-to-r from-[#FFEFE5] via-[#FFF9F4] to-[#FFEFE5] border-2 border-[#F6DCCD] rounded-3xl p-8 sm:p-10 text-center max-w-3xl mx-auto shadow-sm">
      <div class="w-12 h-12 rounded-full bg-[#128C4A]/10 text-[#128C4A] mx-auto flex items-center justify-center text-2xl mb-4">
        📋
      </div>
      <h3 class="font-brand font-bold text-xl sm:text-2xl text-[#4B2E22] mb-3">
        Mencari Layanan Lain? Tersedia 39 Menu Lengkap
      </h3>
      <p class="text-sm sm:text-base text-[#86675A] leading-relaxed mb-6 max-w-xl mx-auto">
        Mulai dari tindik telinga bayi steril, terapi uap (nebulizer saline), infrared moksa, pijat lahap makan anak, prenatal yoga hamil, hingga breast care laktasi.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <WhatsAppButton
          refCode="KALA-KATALOG"
          message="Halo Bidan Kala, boleh minta pricelist dan katalog lengkap 39 layanan Kala? [ref: KALA-KATALOG]"
          text="Minta Katalog Lengkap 39 Menu via WhatsApp"
          variant="secondary"
          phone={phone}
        />
      </div>
    </div>
  </div>
</section>
