---
import WhatsAppButton from '../WhatsAppButton.astro';

interface Props {
  block: {
    badge?: string;
    headline: string;
    subheadline: string;
    price?: string;
    originalPrice?: string;
    duration?: string;
    ctaText?: string;
    ctaMessage?: string;
    image?: { url?: string; alt?: string } | string;
    imageAlt?: string;
    align?: 'center' | 'left';
    btnColor?: 'terracotta' | 'whatsapp' | 'chocolate';
    bgStyle?: 'gradient' | 'plain' | 'white';
  };
}

const { block } = Astro.props;

const bgStyles = {
  gradient: 'bg-gradient-to-b from-[#FFEFE5]/80 via-[#FFF9F4] to-[#FFF9F4]',
  plain: 'bg-[#FFEFE5]',
  white: 'bg-white',
};

const currentBg = bgStyles[block.bgStyle || 'gradient'] || bgStyles.gradient;
const rawImageUrl = typeof block.image === 'string' ? block.image : block.image?.url;
const imageUrl = rawImageUrl
  ? rawImageUrl.startsWith('http') || rawImageUrl.startsWith('//')
    ? rawImageUrl
    : rawImageUrl.startsWith('/images/')
      ? rawImageUrl
      : `https://admin.kalababyspa.com${rawImageUrl.startsWith('/') ? '' : '/'}${rawImageUrl}`
  : null;
const imageAlt = block.imageAlt || (typeof block.image === 'object' ? block.image?.alt : null) || block.headline;

const isLeft = block.align === 'left' || Boolean(imageUrl);
const btnVariant = block.btnColor === 'whatsapp' ? 'secondary' : 'primary';
---

<section class={`py-12 md:py-20 border-b border-[#F6DCCD] relative overflow-hidden ${currentBg}`}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class={`flex flex-col ${isLeft ? 'lg:flex-row items-center gap-10 lg:gap-14 text-left' : 'items-center text-center max-w-3xl mx-auto'}`}>
      
      <!-- Text Column -->
      <div class="flex-1">
        {block.badge && (
          <div class="mb-4">
            <span class="inline-flex items-center gap-1.5 text-xs font-bold tracking-wider text-[#B3471E] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD] shadow-xs">
              {block.badge}
            </span>
          </div>
        )}

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-brand font-bold text-[#4B2E22] mb-5 leading-tight">
          {block.headline}
        </h1>

        <p class="text-base sm:text-lg text-[#86675A] mb-8 leading-relaxed max-w-2xl">
          {block.subheadline}
        </p>

        <!-- Price & Duration Box (if provided) -->
        {(block.price || block.duration) && (
          <div class={`p-4 sm:p-5 rounded-2xl bg-white border border-[#F6DCCD] shadow-sm mb-8 inline-flex flex-wrap items-center gap-4 sm:gap-6 ${imageUrl ? '' : 'justify-center'}`}>
            {block.price && (
              <div>
                <span class="text-xs text-[#86675A] block font-medium">Biaya Mulai</span>
                <div class="flex items-baseline gap-2">
                  <span class="text-2xl sm:text-3xl font-brand font-bold text-[#B3471E]">
                    {block.price}
                  </span>
                  {block.originalPrice && (
                    <span class="text-sm text-[#86675A]/60 line-through">
                      {block.originalPrice}
                    </span>
                  )}
                </div>
              </div>
            )}
            {block.price && block.duration && (
              <div class="h-8 w-[1px] bg-[#F6DCCD] hidden sm:block"></div>
            )}
            {block.duration && (
              <div>
                <span class="text-xs text-[#86675A] block font-medium">Durasi Layanan</span>
                <span class="text-base sm:text-lg font-bold text-[#4B2E22] flex items-center gap-1.5">
                  ⏱️ {block.duration}
                </span>
              </div>
            )}
          </div>
        )}

        <!-- CTA WhatsApp Button -->
        <div class="flex flex-col sm:flex-row items-center gap-3">
          <WhatsAppButton
            refCode="HERO-BLOCK"
            message={block.ctaMessage || `Halo Bu Bidan, saya mau tanya seputar ${block.headline}`}
            text={block.ctaText || 'Konsultasi Gratis via WhatsApp'}
            variant="primary"
            className="w-full sm:w-auto text-base shadow-lg"
          />
          <span class="text-xs text-[#86675A] flex items-center gap-1.5 pt-1 sm:pt-0">
            <span class="w-2 h-2 rounded-full bg-[#0E733D] animate-pulse"></span>
            Bidan standby konsultasi via WA
          </span>
        </div>
      </div>

      <!-- Optional Hero Image Column -->
      {imageUrl && (
        <div class="w-full lg:w-5/12 mt-8 lg:mt-0 flex-shrink-0">
          <div class="relative rounded-3xl overflow-hidden border-2 border-[#F6DCCD] shadow-kala bg-white">
            <img
              src={imageUrl}
              alt={imageAlt || block.headline}
              class="w-full h-auto object-cover aspect-[4/3] sm:aspect-[16/10]"
              loading="eager"
            />
          </div>
        </div>
      )}

    </div>
  </div>
</section>
