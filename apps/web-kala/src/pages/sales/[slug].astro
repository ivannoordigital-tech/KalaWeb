              <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                {campaign.solutions.map((sol) => (
                  <div class="p-6 rounded-2xl bg-white border border-[#F6DCCD] shadow-sm">
                    <span class="text-2xl mb-3 block">🌿</span>
