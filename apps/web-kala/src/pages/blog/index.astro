---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { fetchPayloadArticles, mediaUrl } from '../../lib/payload';

interface BlogCard {
  slug: string;
  title: string;
  description: string;
  category: 'bayi' | 'ibu-menyusui' | 'layanan' | 'kehamilan';
  pubDate: Date;
  author: string;
  heroImage?: string;
  heroImageAlt?: string;
}

const cmsArticles = await fetchPayloadArticles();

// Fallback Markdown hanya dipakai selama transisi / saat CMS belum berisi artikel.
// Di production, kegagalan fetch CMS akan menggagalkan build (fail-safe).
const markdownPosts = await getCollection('blog', ({ data }) => !data.draft);

const cmsSlugs = new Set(cmsArticles.map((article) => article.slug));

const posts: BlogCard[] = [
  ...cmsArticles.map((article) => ({
    slug: article.slug,
    title: article.title,
    description: article.description,
    category: article.category,
    pubDate: new Date(article.pubDate),
    author: article.author,
    heroImage: mediaUrl(article.heroImage, article.heroImageUrlFallback),
    heroImageAlt: article.heroImageAlt,
  })),
  // Artikel Markdown yang belum ada di CMS tetap tampil agar tidak hilang
  // selama masa transisi.
  ...markdownPosts
    .filter((post) => !cmsSlugs.has(post.slug))
    .map((post) => ({
      slug: post.slug,
      title: post.data.title,
      description: post.data.description,
      category: post.data.category,
      pubDate: post.data.pubDate,
      author: post.data.author,
      heroImage: mediaUrl(post.data.heroImage),
      heroImageAlt: post.data.heroImageAlt,
    })),
];

const sortedPosts = posts.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Blog Edukasi', url: '/blog' },
];
---

<BaseLayout
  title="Blog Edukasi Ibu & Bayi"
  description="Kumpulan artikel ilmiah dan panduan praktis kebidanan: pijat bayi kolik, let-down reflex ASI oksitosin, stimulasi newborn, dan standar homecare medis di Surabaya & Sidoarjo."
  canonical="https://kalababyspa.com/blog"
  breadcrumbs={breadcrumbs}
>
  <div class="py-14 md:py-20 bg-[#FFF9F4]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Page Header -->
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-bold tracking-wider text-[#B3471E] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD]">
          Klinik Edukasi Kala
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-brand font-bold text-[#4B2E22] mt-4 mb-4">
          Pusat Edukasi Ibu & Bayi
        </h1>
        <p class="text-base text-[#86675A] leading-relaxed">
          Semua artikel disusun dan ditinjau oleh tenaga bidan profesional ber-STR resmi untuk menemani perjalanan Bunda dengan rasa tenang dan berbasis ilmu medis yang benar.
        </p>
      </div>

      <!-- Articles Grid -->
      {sortedPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPosts.map((post) => (
            <article class="bg-white rounded-3xl border border-[#F6DCCD] overflow-hidden flex flex-col justify-between hover:shadow-kala transition-all duration-300">
              {post.heroImage && (
                <a href={`/blog/${post.slug}`} class="block aspect-[16/9] overflow-hidden bg-[#FFEFE5] border-b border-[#F6DCCD]">
                  <img
                    src={post.heroImage}
                    alt={post.heroImageAlt || post.title}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="p-8">
                <div class="flex items-center justify-between text-xs text-[#86675A] mb-4">
                  <span class="px-3 py-1 bg-[#FFEFE5] text-[#B3471E] font-bold rounded-lg border border-[#F6DCCD] uppercase tracking-wider text-[10px]">
                    {post.category}
                  </span>
                  <span>
                    {new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }).format(post.pubDate)}
                  </span>
                </div>

                <h2 class="font-brand font-bold text-xl text-[#4B2E22] mb-3 leading-snug hover:text-[#B3471E] transition-colors">
                  <a href={`/blog/${post.slug}`}>
                    {post.title}
                  </a>
                </h2>

                <p class="text-sm text-[#86675A] leading-relaxed line-clamp-3 mb-4">
                  {post.description}
                </p>
              </div>

              <div class="p-8 pt-0 border-t border-[#F6DCCD]/60 mt-4 flex items-center justify-between text-xs">
                <span class="text-[#86675A]">Penulis: <strong class="text-[#4B2E22]">{post.author}</strong></span>
                <a href={`/blog/${post.slug}`} class="font-bold text-[#B3471E] hover:underline flex items-center gap-1">
                  Baca Artikel →
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-20 bg-white rounded-3xl border border-[#F6DCCD]">
          <p class="text-[#86675A]">Belum ada artikel yang diterbitkan.</p>
        </div>
      )}

    </div>
  </div>
</BaseLayout>
