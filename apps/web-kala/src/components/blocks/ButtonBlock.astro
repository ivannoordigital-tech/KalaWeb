---
import WhatsAppButton from '../WhatsAppButton.astro';
import { siteConfig } from '../../config/site';

interface Props {
  block: {
    text: string;
    action?: 'whatsapp' | 'url';
    style?: 'primary' | 'secondary' | 'outline';
    whatsappMessage?: string;
    url?: string;
    openInNewTab?: boolean;
    size?: 'sm' | 'md' | 'lg';
    align?: 'left' | 'center' | 'right';
    note?: string;
  };
}

const { block } = Astro.props;

const alignClasses: Record<string, string> = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
};
const sizeClasses: Record<string, string> = {
  sm: 'text-sm py-2.5 px-5',
  md: 'text-base py-3.5 px-6',
  lg: 'text-lg py-4 px-8',
};

const waVariant = block.style === 'secondary' ? 'secondary' : 'primary';
const waClass = `${sizeClasses[block.size || 'md']} shadow-md`;
const linkClass = block.style === 'outline'
  ? `inline-flex items-center justify-center gap-2 rounded-full border-2 border-[#B3471E] text-[#B3471E] font-bold hover:bg-[#B3471E] hover:text-white transition-colors ${sizeClasses[block.size || 'md']}`
  : `inline-flex items-center justify-center gap-2 rounded-full bg-[#B3471E] hover:bg-[#A3431F] text-white font-bold shadow-md transition-colors ${sizeClasses[block.size || 'md']}`;

const isWhatsApp = (block.action || 'whatsapp') === 'whatsapp';
const href = block.url || '#';
const target = block.openInNewTab ? '_blank' : undefined;
const rel = block.openInNewTab ? 'noopener noreferrer' : undefined;
---

<section class="py-6 md:py-8">
  <div class={`px-4 sm:px-6 ${alignClasses[block.align || 'center'] || alignClasses.center}`}>
    {isWhatsApp ? (
      <WhatsAppButton
        refCode="KALA-BLOCK-BTN"
        message={block.whatsappMessage || `Halo Bu Bidan, saya mau tanya seputar ${block.text}`}
        text={block.text}
        variant={waVariant as any}
        className={waClass}
        phone={siteConfig.whatsappNumber}
      />
    ) : (
      <a href={href} target={target} rel={rel} class={linkClass}>
        {block.text}
      </a>
    )}
    {block.note && (
      <p class="mt-3 text-xs text-[#86675A]">{block.note}</p>
    )}
  </div>
</section>
