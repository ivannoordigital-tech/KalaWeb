---
import BaseLayout from './BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  entry: {
    slug: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      updatedDate: Date;
      author: string;
      authorTitle?: string;
      category: 'bayi' | 'ibu-menyusui' | 'layanan' | 'kehamilan';
      heroImage?: string;
      heroImageAlt?: string;
      keywords?: string[];
      medicalReviewer?: string;
      draft?: boolean;
      seo?: {
        metaTitle?: string;
        ogImage?: { url?: string; alt?: string } | string;
        noIndex?: boolean;
        canonicalUrl?: string;
      };
    };
  };
}

const { entry } = Astro.props;
const { data, slug } = entry;

// Determine specific refCode and message per article
let artRefCode = 'KALA-ART';
let artWaMessage = `Halo Bu Bidan, saya membaca artikel "${data.title}" dan mau konsultasi`;

if (slug.includes('kolik')) {
  artRefCode = 'KALA-ART-KOLIK';
  artWaMessage = 'Halo Bu Bidan, saya baru membaca artikel tentang kolik dan mau konsultasi';
} else if (slug.includes('oksitosin')) {
  artRefCode = 'KALA-ART-OKSITOSIN';
  artWaMessage = 'Halo Bu Bidan, saya mau tanya soal layanan pijat oksitosin';
} else if (slug.includes('homecare') || slug.includes('surabaya')) {
  artRefCode = 'KALA-ART-HOMECARE';
  artWaMessage = 'Halo Bu Bidan, saya mau reservasi pijat bayi homecare';
}

const formattedPubDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(data.pubDate);

const formattedUpdateDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(data.updatedDate);

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Blog Edukasi', url: '/blog' },
  { name: data.title, url: `/blog/${slug}` },
];

const resolvedOgImage = typeof data.seo?.ogImage === 'object' && data.seo?.ogImage !== null
  ? (data.seo.ogImage.url || data.heroImage)
  : typeof data.seo?.ogImage === 'string' && data.seo.ogImage
    ? data.seo.ogImage
    : data.heroImage;

const resolvedCanonical = data.seo?.canonicalUrl || `https://kalababyspa.com/blog/${slug}`;
---

<BaseLayout
  title={data.seo?.metaTitle || data.title}
  description={data.description}
  canonical={resolvedCanonical}
  type="article"
  image={resolvedOgImage}
  publishedTime={data.pubDate.toISOString()}
  modifiedTime={data.updatedDate.toISOString()}
  author={data.author}
  keywords={data.keywords}
  noindex={data.seo?.noIndex || false}
  schemaType="article"
  articleData={{
    title: data.seo?.metaTitle || data.title,
    description: data.description,
    pubDate: data.pubDate,
    updatedDate: data.updatedDate,
    author: data.author,
    authorTitle: data.authorTitle,
    url: resolvedCanonical,
    heroImage: resolvedOgImage || data.heroImage,
  }}
  breadcrumbs={breadcrumbs}
>
  <article class="py-12 md:py-16 bg-[#FFF9F4]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-[#86675A] mb-8 overflow-x-auto whitespace-nowrap" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#B3471E] transition-colors">Beranda</a>
        <span>›</span>
        <a href="/blog" class="hover:text-[#B3471E] transition-colors">Blog Edukasi</a>
        <span>›</span>
        <span class="text-[#4B2E22] font-semibold truncate max-w-xs">{data.title}</span>
      </nav>

      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b border-[#F6DCCD]">
        <div class="flex flex-wrap items-center gap-2.5 mb-4">
          <span class="text-xs font-bold tracking-wider text-[#B3471E] uppercase bg-[#FFEFE5] px-3 py-1 rounded-full border border-[#F6DCCD]">
            Pilar: {data.category}
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-[#0E733D] bg-[#0E733D]/10 px-3 py-1 rounded-full border border-[#0E733D]/20">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0E733D]"></span>
            Ditinjau Bidan Bersertifikat
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-[#4B2E22] tracking-tight leading-tight mb-5">
          {data.title}
        </h1>

        <!-- Metadata Row -->
        <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-[#86675A] pt-2">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-[#FFD9C4] text-[#B3471E] flex items-center justify-center font-bold text-xs">
              👩‍⚕️
            </div>
            <div>
              <span class="font-bold text-[#4B2E22] block">{data.author}</span>
              <span class="text-[11px] text-[#86675A]">{data.authorTitle || 'Bidan Kala'}</span>
            </div>
          </div>
          <span class="text-[#F6DCCD]">|</span>
          <div>
            <span>Terbit: {formattedPubDate}</span>
            {data.updatedDate > data.pubDate && (
              <span class="block text-[11px] text-[#B3471E]">Diperbarui: {formattedUpdateDate}</span>
            )}
          </div>
          <span class="text-[#F6DCCD]">|</span>
          <div class="text-[11px] text-[#86675A]">
            Reviewer Medis: <span class="font-semibold text-[#4B2E22]">{data.medicalReviewer || 'Tim Medis Kala'}</span>
          </div>
        </div>
      </header>

      <!-- Article Prose Content -->
      <div class="prose-kala max-w-none text-base sm:text-lg">
        <slot />
      </div>

      <!-- Midwife Author Bio Box -->
      <div class="mt-14 p-6 sm:p-8 rounded-3xl bg-white border border-[#F6DCCD] shadow-sm">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
          <div class="w-16 h-16 rounded-2xl bg-[#FFEFE5] text-[#B3471E] flex items-center justify-center font-bold text-2xl flex-shrink-0 border border-[#F6DCCD]">
            👩‍⚕️
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap mb-1">
              <h3 class="font-brand font-bold text-lg text-[#4B2E22]">{data.author}</h3>
              <span class="text-xs px-2.5 py-0.5 bg-[#FFEFE5] text-[#B3471E] rounded-full font-semibold border border-[#F6DCCD]">
                Bidan Resmi Ber-STR
              </span>
            </div>
            <p class="text-xs sm:text-sm text-[#86675A] leading-relaxed">
              Praktisi kebidanan profesional di Kala Moms and Baby Spa dengan peminatan stimulasi taktil newborn, manajemen laktasi, dan pendampingan masa nifas tanpa mom-shaming di area Surabaya & Sidoarjo.
            </p>
          </div>
        </div>
      </div>

      <!-- Related Services & Internal Linking (Track B5) -->
      <div class="mt-8 p-6 rounded-3xl bg-white border border-[#F6DCCD] shadow-sm">
        <h3 class="font-brand font-bold text-base sm:text-lg text-[#4B2E22] mb-2 flex items-center gap-2">
          <span>🌿</span> Layanan Homecare Terkait di Surabaya & Sidoarjo
        </h3>
        <p class="text-xs sm:text-sm text-[#86675A] mb-4">
          Tindakan langsung ditangani bidan ber-STR di kenyamanan rumah Bunda tanpa antre:
        </p>
        <div class="flex flex-wrap gap-2.5">
          <a href="/layanan/baby-newborn" class="inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-2 rounded-full bg-[#FFEFE5] text-[#B3471E] border border-[#F6DCCD] hover:bg-[#B3471E] hover:text-white transition-all">
            👶 Pijat Ceria Newborn
          </a>
          <a href="/layanan/bundle-duo" class="inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-2 rounded-full bg-[#FFEFE5] text-[#B3471E] border border-[#F6DCCD] hover:bg-[#B3471E] hover:text-white transition-all">
            🤱 Kala Bundle Duo (Mom & Baby)
          </a>
          <a href="/layanan/bundle-selapan" class="inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-2 rounded-full bg-[#FFEFE5] text-[#B3471E] border border-[#F6DCCD] hover:bg-[#B3471E] hover:text-white transition-all">
            ✂️ Paket Cukur & Selapanan
          </a>
          <a href="/layanan" class="inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-2 rounded-full bg-[#FAF6F0] text-[#4B2E22] border border-[#E5DAC6] hover:bg-[#E5DAC6] transition-all">
            Lihat Semua 13+ Layanan →
          </a>
          <a href="/area" class="inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-2 rounded-full bg-[#FAF6F0] text-[#4B2E22] border border-[#E5DAC6] hover:bg-[#E5DAC6] transition-all">
            Cakupan Area Layanan →
          </a>
        </div>
      </div>

      <!-- Article WhatsApp Consultation Banner -->
      <div class="mt-10 p-8 rounded-3xl bg-gradient-to-br from-[#FFEFE5] via-[#FFF9F4] to-[#FFEFE5] border-2 border-[#F6DCCD] text-center shadow-kala">
        <span class="text-xs font-bold text-[#B3471E] uppercase tracking-wider bg-white px-3 py-1 rounded-full border border-[#F6DCCD] inline-block mb-3">
          Konsultasi Hangat Langsung
        </span>
        <h3 class="font-brand font-bold text-xl sm:text-2xl text-[#4B2E22] mb-3">
          Punya Pertanyaan Seputar Keluhan Si Kecil atau Pemulihan Nifas?
        </h3>
        <p class="text-sm text-[#86675A] max-w-xl mx-auto mb-6">
          Bicarakan kondisi Bunda dan si kecil dengan bidan Kala. Kami siap membantu reservasi kunjungan homecare steril ke rumah Anda di Surabaya & Sidoarjo.
        </p>
        <WhatsAppButton
          refCode={artRefCode}
          message={artWaMessage}
          text="Konsultasikan dengan Bidan via WhatsApp"
          variant="primary"
          className="text-base py-3.5 px-8"
        />
      </div>

      <!-- Back to Blog Navigation -->
      <div class="mt-12 pt-6 border-t border-[#F6DCCD] flex items-center justify-between text-sm">
        <a href="/blog" class="font-bold text-[#B3471E] hover:underline flex items-center gap-1">
          ← Kembali ke Semua Artikel
        </a>
        <a href="/#layanan" class="font-bold text-[#4B2E22] hover:text-[#B3471E]">
          Lihat Menu Layanan Homecare →
        </a>
      </div>

    </div>
  </article>
</BaseLayout>
