    <!-- Sticky Mobile CTA Bar -->
    <MobileStickyBar phone={siteConfig.whatsappNumber} />

    <!-- Privacy Consent Banner -->
    <ConsentBanner />

    <!-- Tracker Script -->
    <script src="../../scripts/tracker.js"></script>
  </body>
</html>
