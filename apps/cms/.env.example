# ==============================================================================
# Kala CMS - Environment Variables Example
# ==============================================================================

# Password user PostgreSQL kala_cms_user
# CATATAN: Password wajib URL-encoded jika mengandung karakter khusus
# Contoh: ! -> %21, @ -> %40, # -> %23, $ -> %24
CMS_DB_PASSWORD=GantiDenganPasswordSangatKuat2026%21

# Connection String PostgreSQL untuk DEVELOPMENT LOKAL (tanpa Docker Compose).
# CATATAN: Docker Compose mengabaikan baris ini dan membangun DATABASE_URI sendiri
# dari variabel CMS_DB_PASSWORD di atas. Nilai di .env TIDAK mendukung ${VAR}.
DATABASE_URI=postgresql://kala_cms_user:GantiDenganPasswordSangatKuat2026%21@127.0.0.1:5432/kala_cms_db

# Kunci rahasia Payload CMS (wajib acak & kuat di production, min 32 char)
PAYLOAD_SECRET=ganti_dengan_token_random_32_karakter_super_aman_2026

# URL publik admin CMS
NEXT_PUBLIC_SERVER_URL=https://admin.kalababyspa.com

# URL Frontend untuk Preview Konten / Draft (Production: https://kalababyspa.com, Dev: http://localhost:4321)
PREVIEW_BASE_URL=https://kalababyspa.com

# Rahasia tanda tangan token preview (WAJIB, minimal 32 karakter, acak).
# Nilai ini HARUS SAMA dengan PREVIEW_SECRET di environment web/Cloudflare.
PREVIEW_SECRET=ganti_dengan_secret_preview_minimal_32_karakter_acak_2026

# Password seed awal untuk admin@kalababyspa.com (wajib jika menjalankan npm run seed)
ADMIN_SEED_PASSWORD=

# Password darurat saat membuat admin baru via script set:superadmin
NEW_ADMIN_PASSWORD=

# Deploy Hook Cloudflare Pages untuk auto-build website saat konten terbit
CLOUDFLARE_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/YOUR_HOOK_ID
# Cloudflare API (DEP-001: Pelacakan Status Build Nyata dari Cloudflare Pages)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT_NAME=kala-web

# Kunci API khusus bot klinik (Kala Clinic Bot) untuk POST ulasan/testimoni.
# WAJIB diisi di production (seed akan gagal bila kosong).
CMS_BOT_API_KEY=

# Password akun service bot@kalababyspa.com (role operator). WAJIB di production.
BOT_OPERATOR_PASSWORD=

# Notifikasi Status Build Otomatis (Telegram, opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Cloudflare R2 Storage & CDN (MED-002: Pustaka Media Terdistribusi)
# Jika diisi, upload baru otomatis tersimpan di R2 bucket.
# Jika kosong, CMS otomatis menggunakan penyimpanan file lokal (disk).
R2_BUCKET=kala-media
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# URL Publik CDN untuk melayani aset media (contoh: https://cdn.kalababyspa.com)
MEDIA_PUBLIC_URL=https://cdn.kalababyspa.com
