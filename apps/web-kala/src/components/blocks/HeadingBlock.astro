---
interface Props {
  block: {
    eyebrow?: string;
    text: string;
    subtitle?: string;
    level?: 'h2' | 'h3' | 'h4';
    size?: 'sm' | 'md' | 'lg' | 'xl';
    align?: 'left' | 'center';
  };
}

const { block } = Astro.props;

const Tag = (block.level || 'h2') as any;
const sizes: Record<string, string> = {
  sm: 'text-xl sm:text-2xl',
  md: 'text-2xl sm:text-3xl',
  lg: 'text-3xl sm:text-4xl',
  xl: 'text-4xl sm:text-5xl',
};
const alignClass = block.align === 'left' ? 'text-left' : 'text-center';
---

<section class="py-8 md:py-10">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class={alignClass}>
      {block.eyebrow && (
        <span class="inline-block text-xs font-bold tracking-wider text-[#B3471E] uppercase bg-[#FFEFE5] px-3 py-1 rounded-full border border-[#F6DCCD] mb-3">
          {block.eyebrow}
        </span>
      )}
      <Tag class={`font-brand font-bold text-[#4B2E22] leading-tight ${sizes[block.size || 'md'] || sizes.md}`}>
        {block.text}
      </Tag>
      {block.subtitle && (
        <p class="mt-3 text-base sm:text-lg text-[#86675A] leading-relaxed max-w-2xl mx-auto">
          {block.subtitle}
        </p>
      )}
    </div>
  </div>
</section>
