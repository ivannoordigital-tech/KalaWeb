---
import BlockRenderer from '../../../components/blocks/BlockRenderer.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import MobileStickyBar from '../../../components/MobileStickyBar.astro';
import ConsentBanner from '../../../components/ConsentBanner.astro';
import { siteConfig } from '../../../config/site';
import { fetchPayloadLandingPages } from '../../../lib/payload';
import '../../../styles/global.css';

export async function getStaticPaths() {
  const cmsLps = await fetchPayloadLandingPages();

  const fallbackCampaigns = [
    { slug: 'bayi-kolik', title: 'Solusi Tangis Kolik & Perut Kembung Bayi di Surabaya & Sidoarjo' },
    { slug: 'pijat-newborn', title: 'Pijat Ceria Newborn Homecare Surabaya & Sidoarjo' },
    { slug: 'reservasi-online', title: 'Reservasi Homecare Bidan Kala' },
  ];

  const allSlugs = new Set([
    ...cmsLps.map((lp) => lp.slug),
    ...fallbackCampaigns.map((f) => f.slug),
  ]);

  return Array.from(allSlugs).map((slug) => {
    const pageData = cmsLps.find((lp) => lp.slug === slug);
    return {
      params: { slug },
      props: { pageData },
    };
  });
}

const { slug } = Astro.params;
const { pageData } = Astro.props;

const PAYLOAD_URL = import.meta.env.PAYLOAD_URL || 'https://admin.kalababyspa.com';

const title = pageData?.title || `Pratinjau Draft: ${slug}`;
const blocks = Array.isArray(pageData?.layout) ? pageData.layout : [];
const hasBlocks = blocks.length > 0;
const isCanvas = pageData?.pageLayout === 'canvas';
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate" />
    <title>[PRATINJAU DRAFT] {title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="kala:lp-slug" content={slug} />
    <meta name="kala:variant" content={pageData?.variant || (slug.endsWith('-b') ? 'B' : slug.endsWith('-c') ? 'C' : 'A')} />
    <meta name="kala:ref-code" content={pageData?.refCode || 'PREVIEW-DRAFT'} />
  </head>
  <body class="bg-[#FFF9F4] text-[#4B2E22] min-h-screen flex flex-col font-sans selection:bg-[#FFD9C4] pb-24 md:pb-0">
    
    <!-- Prominent Draft Preview Banner (Sticky) -->
    <aside class="bg-amber-500 text-slate-950 font-bold px-4 py-3 text-center text-xs sm:text-sm sticky top-0 z-50 flex flex-wrap items-center justify-center gap-2 shadow-md">
      <span class="bg-slate-950 text-amber-400 px-2 py-0.5 rounded text-[11px] font-mono tracking-wider uppercase">
        PRATINJAU DRAFT
      </span>
      <span>Halaman ini adalah mode pratinjau editor CMS. Perubahan belum terbit ke pengunjung publik.</span>
      <a
        href={`https://admin.kalababyspa.com/admin/collections/landing-pages`}
        target="_blank"
        rel="noopener noreferrer"
        class="underline hover:text-white transition-colors ml-2"
      >
        Kembali ke CMS Editor →
      </a>
    </aside>

    <!-- Minimalist Header -->
    {!isCanvas && (
    <header class="py-4 px-4 bg-white/95 backdrop-blur-md border-b border-[#F6DCCD] sticky top-10 z-30">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
          <img
            src="/images/logo-icon.webp"
            alt="Logo Kala Homecare"
            width="36"
            height="36"
            class="w-9 h-9 object-contain"
          />
          <span class="font-brand font-bold text-lg text-[#4B2E22]">Kala Homecare</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold text-[#128C4A] bg-[#E8F8EE] px-2.5 py-1 rounded-full border border-[#C5ECD2]">
            ✓ Bidan Bersertifikat
          </span>
          <span class="text-xs text-[#86675A] font-semibold">Surabaya & Sidoarjo</span>
        </div>
      </div>
    </header>
    )}

    <main class="flex-grow">
      {hasBlocks ? (
        blocks.map((block: any) => (
          <BlockRenderer block={block} />
        ))
      ) : (
        <div class="py-16 px-4 text-center max-w-2xl mx-auto">
          <div class="w-16 h-16 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-3xl mx-auto mb-4">
            📄
          </div>
          <h1 class="text-2xl font-bold font-brand text-[#4B2E22] mb-2">{title}</h1>
          <p class="text-sm text-[#86675A] mb-6">
            Belum ada susunan blok yang disimpan pada landing page ini di CMS. Silakan tambahkan minimal satu Hero Block di editor CMS Anda.
          </p>
          <a
            href="https://admin.kalababyspa.com/admin/collections/landing-pages"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-[#C2552B] text-white px-6 py-2.5 rounded-full text-sm font-bold shadow-md hover:bg-[#A3431E] transition-colors"
          >
            Buka Editor CMS
          </a>
        </div>
      )}
    </main>

    <!-- Sticky Mobile CTA Bar -->
    <MobileStickyBar phone={siteConfig.whatsappNumber} />

    <!-- Privacy Consent Banner -->
    <ConsentBanner />

    <!-- Tracker Script -->
    <script src="../../../scripts/tracker.js"></script>

    <!-- Payload CMS Side-by-Side Live Preview Message Listener -->
    <script is:inline>
      (function initPayloadLivePreview() {
        if (typeof window === 'undefined') return;
        const isInsideIframe = window.self !== window.top;
        if (isInsideIframe) {
          console.log('[KalaWeb Live Preview] Connected to Payload CMS Editor iframe.');
          window.addEventListener('message', function(event) {
            if (event.data && (event.data.type === 'payload-live-preview' || event.data.type === 'payload-live-preview-ready')) {
              if (event.data.data) {
                const updated = event.data.data;
                if (updated.title) {
                  document.title = '[PRATINJAU DRAFT] ' + updated.title;
                }
                const heroH1 = document.querySelector('section h1, main h1');
                if (heroH1 && (updated.headline || updated.title)) {
                  heroH1.textContent = updated.headline || updated.title;
                }
                const heroSub = document.querySelector('section p.text-base, main p.text-base');
                if (heroSub && updated.subheadline) {
                  heroSub.textContent = updated.subheadline;
                }
              }
            }
          });
          try {
            window.parent.postMessage({ type: 'payload-live-preview-ready' }, '*');
          } catch (e) {}
        }
      })();
    </script>
  </body>
</html>
