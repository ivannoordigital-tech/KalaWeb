---
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import { fetchSiteSettings } from '../lib/payload';
import { siteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  keywords?: string[];
  noindex?: boolean;
  schemaType?: 'home' | 'article' | 'page' | 'service' | 'person';
  articleData?: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate: Date;
    author: string;
    authorTitle?: string;
    url: string;
    heroImage?: string;
  };
  serviceData?: {
    name: string;
    description: string;
    price: number;
    duration?: string;
    url: string;
  };
  personData?: {
    name: string;
    title: string;
    strNumber?: string;
    bio?: string;
    image?: string;
    url?: string;
  };
  breadcrumbs?: Array<{ name: string; url: string }>;
  showFloatingWa?: boolean;
  pageLayout?: 'default' | 'canvas' | 'full_width';
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description,
  canonical,
  type = 'website',
  image,
  publishedTime,
  modifiedTime,
  author,
  keywords,
  noindex = false,
  schemaType = 'page',
  articleData,
  serviceData,
  personData,
  breadcrumbs,
  showFloatingWa = true,
  pageLayout = 'default',
  hideHeader = false,
  hideFooter = false,
} = Astro.props;

// Fetch dynamic global site settings at build time (falls back gracefully to siteConfig)
const cmsSettings = await fetchSiteSettings();
const siteSettings = {
  ...siteConfig,
  whatsappNumber: cmsSettings?.whatsappNumber || siteConfig.whatsappNumber,
  whatsappNumberFormatted: cmsSettings?.whatsappNumberFormatted || siteConfig.whatsappNumberFormatted,
  instagram: cmsSettings?.instagram || siteConfig.instagram,
  operationalHours: cmsSettings?.operationalHours || siteConfig.operationalHours,
  socialProofText: cmsSettings?.socialProofText || siteConfig.socialProofText,
  heroBadgeText: cmsSettings?.heroBadgeText || 'Dipercaya 1000+ Orang Tua di Surabaya & Sidoarjo',
  announcementBanner: cmsSettings?.announcementBanner || '',
  coverageAreas: cmsSettings?.coverageAreas?.length ? cmsSettings.coverageAreas.map((c) => c.area) : siteConfig.coverageAreas,
};

const gtmId = import.meta.env.PUBLIC_GTM_ID || 'GTM-XXXXXXX';
const isCanvas = pageLayout === 'canvas';
const isFullWidth = pageLayout === 'full_width';
const showNavbar = !isCanvas && !hideHeader;
const showFooter = !isCanvas && !hideFooter;
const showAnnouncement = !isCanvas && Boolean(siteSettings.announcementBanner);
const showFloating = !isCanvas && showFloatingWa;
const showMobileBar = !isCanvas;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFBE9C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Tag Manager (Deferred until idle or interaction to protect LCP & INP) -->
    <script is:inline define:vars={{ gtmId }}>
      (function() {
        var gtmLoaded = false;
        function loadGTM() {
          if (gtmLoaded) return;
          gtmLoaded = true;
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;
          j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer',gtmId);
        }

        if ('requestIdleCallback' in window) {
          requestIdleCallback(function() { setTimeout(loadGTM, 1800); }, { timeout: 3500 });
        } else {
          setTimeout(loadGTM, 2200);
        }

        ['scroll', 'touchstart', 'mousemove', 'click', 'keydown'].forEach(function(evt) {
          window.addEventListener(evt, loadGTM, { once: true, passive: true });
        });
      })();
    </script>
    <!-- End Google Tag Manager -->

    <!-- SEO Meta Tags & Open Graph -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      keywords={keywords}
      noindex={noindex}
    />

    <!-- JSON-LD Structured Data -->
    <JsonLd
      type={schemaType}
      articleData={articleData}
      serviceData={serviceData}
      personData={personData}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body class={`bg-[#FFF9F4] text-[#4B2E22] min-h-screen flex flex-col font-sans selection:bg-[#FFD9C4] selection:text-[#4B2E22] ${isCanvas ? 'p-0 m-0' : 'pb-16 md:pb-0'}`}>
    {showNavbar && (
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-xl focus:bg-white focus:px-4 focus:py-3 focus:text-sm focus:font-bold focus:text-[#4B2E22] focus:shadow-lg focus:ring-2 focus:ring-[#C2552B]"
      >
        Lewati ke konten utama
      </a>
    )}
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
        height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    {showAnnouncement && (
      <aside class="bg-[#C2552B] text-white text-xs sm:text-sm font-semibold py-2 px-4 text-center">
        {siteSettings.announcementBanner}
      </aside>
    )}

    {showNavbar && <Navbar siteSettings={siteSettings} />}

    <main id="main-content" tabindex="-1" class={`flex-grow focus:outline-none ${isFullWidth || isCanvas ? 'w-full' : ''}`}>

      <slot />
    </main>

    {showFooter && <Footer siteSettings={siteSettings} />}

    {showFloating && (
      <div id="desktop-floating-wa" class="hidden md:block fixed bottom-6 right-6 z-50 transition-all duration-300 ease-in-out transform translate-y-6 opacity-0 pointer-events-none">
        <WhatsAppButton
          refCode="KALA-FLOAT"
          message="Halo Bu Bidan, saya mau tanya layanan homecare Kala"
          text="Chat Bidan"
          variant="floating"
          phone={siteSettings.whatsappNumber}
        />
      </div>
    )}

    <!-- Mobile Sticky Bottom CTA Bar -->
    {showMobileBar && <MobileStickyBar phone={siteSettings.whatsappNumber} />}


    <!-- Attribution and WhatsApp Click Script -->
    <script src="../scripts/tracker.js"></script>
  </body>
</html>
