---
interface SolutionItem {
  icon?: string;
  number?: string;
  title: string;
  subtitle?: string;
  description: string;
}

interface Props {
  block: {
    variant?: 'default' | 'benefits' | 'differentiators';
    badge?: string;
    title: string;
    subtitle?: string;
    note?: string;
    items: SolutionItem[];
    highlightQuote?: {
      quote?: string;
      author?: string;
    };
  };
}

const { block } = Astro.props;
const items = block.items || [];
const variant = block.variant || 'default';

const badgeText =
  block.badge ||
  (variant === 'benefits'
    ? 'Solusi untuk Bunda dan Si Kecil'
    : variant === 'differentiators'
      ? 'Kenapa Memilih Kala?'
      : 'Solusi & Keunggulan Kala');

const displayTitle =
  block.title ||
  (variant === 'differentiators'
    ? `${items.length} Hal yang Membuat Kala Berbeda`
    : 'Apa yang Berubah Setelah Perawatan di Kala?');
---

{variant === 'benefits' ? (
  <section class="py-16 md:py-24 bg-white border-y border-[#F6DCCD]/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="inline-block text-xs font-bold tracking-wider text-[#B3471E] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD] mb-4">
          {badgeText}
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-medium text-[#4B2E22] mb-3">
          {displayTitle}
        </h2>
        {block.subtitle && (
          <p class="text-sm sm:text-base text-[#86675A] leading-relaxed">{block.subtitle}</p>
        )}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6">
        {items.map((item, index) => (
          <div
            class={`rounded-3xl bg-[#FFF9F4] border border-[#F6DCCD] p-6 flex flex-col justify-between hover:shadow-kala transition-all duration-300 ${
              index < 3 ? 'lg:col-span-2' : 'lg:col-span-3'
            }`}
          >
            <div>
              <div class="flex items-center gap-3 mb-3">
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#FFD9C4] text-[#B3471E] font-bold text-xs flex-shrink-0">
                  {item.icon || '✓'}
                </span>
                <h3 class="font-brand font-semibold text-base text-[#4B2E22] leading-snug">
                  {item.title}
                </h3>
              </div>
              <p class="text-sm text-[#86675A] leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>

      {block.note && (
        <p class="text-xs text-[#86675A] leading-relaxed text-center mt-8 max-w-2xl mx-auto bg-[#FFEFE5]/60 py-3 px-5 rounded-2xl border border-[#F6DCCD]">
          {block.note}
        </p>
      )}
    </div>
  </section>
) : variant === 'differentiators' ? (
  <section class="py-16 md:py-24 bg-white border-y border-[#F6DCCD]/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="inline-block text-xs font-bold tracking-wider text-[#B3471E] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD]">
          {badgeText}
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-medium text-[#4B2E22] mt-4 mb-4">
          {displayTitle}
        </h2>
        {block.subtitle && (
          <p class="text-sm sm:text-base text-[#86675A] leading-relaxed">{block.subtitle}</p>
        )}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6 sm:gap-8">
        {items.map((item, index) => (
          <div
            class={`p-7 rounded-3xl border border-[#F6DCCD] bg-[#FFF9F4] hover:shadow-kala transition-all duration-300 flex flex-col justify-between ${
              index < 3 ? 'lg:col-span-2' : 'lg:col-span-3'
            }`}
          >
            <div>
              <div class="flex items-center gap-3 mb-3">
                <span class="w-9 h-9 rounded-2xl bg-[#FFEFE5] text-[#B3471E] font-brand font-bold flex items-center justify-center text-sm border border-[#F6DCCD] flex-shrink-0">
                  {item.number || String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="font-brand font-semibold text-lg text-[#4B2E22] leading-snug">
                  {item.title}
                </h3>
              </div>
              {item.subtitle && (
                <div class="inline-block text-xs font-semibold text-[#B3471E] bg-white px-3 py-1 rounded-full border border-[#F6DCCD] mb-3">
                  {item.subtitle}
                </div>
              )}
              <p class="text-sm text-[#86675A] leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>

      {block.note && (
        <p class="text-xs text-[#86675A] leading-relaxed text-center mt-8 max-w-2xl mx-auto bg-[#FFEFE5]/60 py-3 px-5 rounded-2xl border border-[#F6DCCD]">
          {block.note}
        </p>
      )}
    </div>
  </section>
) : (
  <section class="py-14 md:py-20 bg-[#FFF9F4] border-b border-[#F6DCCD]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <span class="text-xs font-bold tracking-wider text-[#0E733D] uppercase bg-[#E8F8EE] px-3.5 py-1.5 rounded-full border border-[#C5ECD2] inline-block mb-3">
          {badgeText}
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-[#4B2E22] mb-3">
          {displayTitle}
        </h2>
        {block.subtitle && (
          <p class="text-sm sm:text-base text-[#86675A] max-w-xl mx-auto">{block.subtitle}</p>
        )}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        {items.map((item) => (
          <div class="p-6 rounded-2xl bg-white border border-[#F6DCCD] shadow-xs flex flex-col justify-between hover:shadow-md transition-shadow">
            <div>
              <div class="w-12 h-12 rounded-2xl bg-[#E8F8EE] text-[#0E733D] flex items-center justify-center text-2xl mb-4 border border-[#C5ECD2]">
                {item.icon || '✓'}
              </div>
              <h3 class="font-bold text-[#4B2E22] text-lg mb-2">{item.title}</h3>
              <p class="text-sm text-[#86675A] leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>

      {block.highlightQuote?.quote && (
        <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-[#FFEFE5] to-white border-2 border-[#F6DCCD] text-center shadow-xs">
          <p class="text-base sm:text-lg font-serif italic text-[#4B2E22] mb-3">
            “{block.highlightQuote.quote}”
          </p>
          {block.highlightQuote.author && (
            <span class="text-xs sm:text-sm font-bold text-[#B3471E] tracking-wide">
              — {block.highlightQuote.author}
            </span>
          )}
        </div>
      )}

      {block.note && (
        <p class="text-xs text-[#86675A] leading-relaxed text-center mt-8 max-w-2xl mx-auto bg-[#FFEFE5]/60 py-3 px-5 rounded-2xl border border-[#F6DCCD]">
          {block.note}
        </p>
      )}
    </div>
  </section>
)}
