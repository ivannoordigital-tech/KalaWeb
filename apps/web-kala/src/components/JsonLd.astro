---
import { siteConfig } from '../config/site';

interface Props {
  type: 'home' | 'article' | 'page' | 'service' | 'person';
  siteSettings?: any;
  articleData?: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate: Date;
    author: string;
    authorTitle?: string;
    url: string;
    heroImage?: string;
  };
  serviceData?: {
    name: string;
    description: string;
    price: number;
    duration?: string;
    url: string;
  };
  personData?: {
    name: string;
    title: string;
    strNumber?: string;
    bio?: string;
    image?: string;
    url?: string;
  };
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const { type, articleData, serviceData, personData, breadcrumbs, siteSettings } = Astro.props;

// Schema LocalBusiness / MedicalBusiness for Homepage
const opensHour = siteSettings?.structuredHours?.opens || '08:00';
const closesHour = siteSettings?.structuredHours?.closes || '17:00';

const citiesList: string[] = siteSettings?.coverageCities && siteSettings.coverageCities.length > 0
  ? siteSettings.coverageCities.map((c: any) => typeof c === 'string' ? c : c.name)
  : (siteSettings?.coverageAreas && siteSettings.coverageAreas.length > 0
    ? siteSettings.coverageAreas.map((a: any) => typeof a === 'string' ? a : a.area)
    : siteConfig.coverageAreas);

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'HealthAndBeautyBusiness'],
  '@id': `${siteConfig.url}/#business`,
  name: siteConfig.name,
  legalName: siteConfig.legalName,
  url: siteConfig.url,
  foundingDate: String(siteConfig.foundedYear),
  logo: `${siteConfig.url}/images/logo-kala.png`,
  image: `${siteConfig.url}/images/og-kala-homecare.png`,
  description: siteConfig.description,
  telephone: `+${siteSettings?.whatsappNumber || siteConfig.whatsappNumber}`,
  priceRange: siteConfig.priceRange,
  currenciesAccepted: 'IDR',
  paymentAccepted: 'Tunai, Transfer Bank, QRIS',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: opensHour,
      closes: closesHour,
    },
  ],
  areaServed: citiesList.map((area) => ({
    '@type': 'AdministrativeArea',
    name: area,
  })),
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteConfig.geo.latitude,
    longitude: siteConfig.geo.longitude,
  },
  sameAs: [
    siteSettings?.instagram
      ? (siteSettings.instagram.startsWith('http') ? siteSettings.instagram : `https://instagram.com/${siteSettings.instagram.replace(/^@/, '')}`)
      : siteConfig.instagramUrl,
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Layanan Unggulan Kala Moms and Baby Spa',
    itemListElement: siteConfig.featuredServices.map((srv, index) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: srv.name,
        description: srv.description,
        provider: {
          '@type': 'MedicalBusiness',
          name: siteConfig.name,
        },
      },
      price: srv.numericPrice,
      priceCurrency: 'IDR',
      priceValidUntil: '2027-12-31',
      position: index + 1,
    })),
  },
};

// Schema Article for Blog posts
const articleSchema = articleData
  ? {
      '@context': 'https://schema.org',
      '@type': 'MedicalWebPage',
      headline: articleData.title,
      description: articleData.description,
      image: articleData.heroImage ? new URL(articleData.heroImage, siteConfig.url).href : `${siteConfig.url}/images/og-kala-homecare.png`,
      datePublished: articleData.pubDate.toISOString(),
      dateModified: articleData.updatedDate.toISOString(),
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': articleData.url,
      },
      author: {
        '@type': 'Person',
        name: articleData.author,
        jobTitle: articleData.authorTitle || 'Bidan Praktisi Kala',
      },
      reviewedBy: {
        '@type': 'MedicalBusiness',
        name: siteConfig.name,
        telephone: `+${siteSettings?.whatsappNumber || siteConfig.whatsappNumber}`,
      },
      publisher: {
        '@type': 'Organization',
        name: siteConfig.name,
        logo: {
          '@type': 'ImageObject',
          url: `${siteConfig.url}/images/logo-kala.png`,
        },
      },
    }
  : null;

// Service & Offer Schema
const serviceSchema = serviceData
  ? {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: serviceData.name,
      description: serviceData.description,
      provider: {
        '@type': 'MedicalBusiness',
        name: siteConfig.name,
        url: siteConfig.url,
        telephone: `+${siteSettings?.whatsappNumber || siteConfig.whatsappNumber}`,
      },
      offers: {
        '@type': 'Offer',
        price: serviceData.price,
        priceCurrency: 'IDR',
        priceValidUntil: '2027-12-31',
        url: serviceData.url,
        availability: 'https://schema.org/InStock',
      },
    }
  : null;

// Person Schema for Midwives
const personSchema = personData
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: personData.name,
      jobTitle: personData.title,
      description: personData.bio,
      image: personData.image,
      worksFor: {
        '@type': 'MedicalBusiness',
        name: siteConfig.name,
        url: siteConfig.url,
      },
      identifier: personData.strNumber
        ? {
            '@type': 'PropertyValue',
            name: 'Nomor Surat Tanda Registrasi (STR) Bidan',
            value: personData.strNumber,
          }
        : undefined,
    }
  : null;

// Breadcrumbs Schema
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((crumb, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: crumb.name,
        item: new URL(crumb.url, siteConfig.url).href,
      })),
    }
  : null;
---

{type === 'home' && (
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
)}

{type === 'article' && articleSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}

{type === 'service' && serviceSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
)}

{type === 'person' && personSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
)}

{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
