---
interface Props {
  titleHtml?: string;
  subtitle?: string;
  buttonText?: string;
  ctaUrl?: string;
  note?: string;
}

const {
  titleHtml = "Berikan Si Kecil<br>Awal Terbaik dalam Hidupnya",
  subtitle = "Konsultasi gratis via WhatsApp sekarang. Tim kami siap membantu Anda memilih paket yang paling tepat untuk si kecil.",
  buttonText = "💬 Chat WhatsApp Sekarang",
  ctaUrl = "https://app.kalababyspa.online/cta?divisi=iklan-utama",
  note = "⏰ Balas dalam 5 menit · Tidak perlu bayar untuk konsultasi pertama",
} = Astro.props;
---

<section class="lb-cta" id="booking">
  <div class="lb-cta__inner reveal">
    <h2 class="lb-cta__title" set:html={titleHtml} />

    <p class="lb-cta__sub">
      {subtitle}
    </p>

    <a
      href={ctaUrl}
      class="lb-btn-white"
      target="_blank"
      rel="noopener noreferrer"
      style="color: #C4714A;"
    >
      {buttonText}
    </a>

    <p class="lb-cta__note">
      {note}
    </p>
  </div>
</section>

<style>
  .lb-cta {
    padding: 120px 48px;
    background: linear-gradient(135deg, #C4714A 0%, #a8562e 100%);
    text-align: center;
  }

  .lb-cta__inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .lb-cta__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.9rem, 3.5vw, 2.8rem);
    line-height: 1.25;
    font-weight: 700;
    color: white;
  }

  .lb-cta__sub {
    color: rgba(255, 255, 255, 0.88);
    font-size: 1.05rem;
    line-height: 1.8;
    max-width: 540px;
    margin: 16px auto 48px;
  }

  .lb-btn-white {
    background: white;
    color: #C4714A !important;
    padding: 18px 48px;
    border-radius: 100px;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
    transition: all 0.25s;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
    animation: floatBtn 3s ease-in-out infinite;
  }

  .lb-btn-white:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.25);
    background: #FFF9F4;
  }

  .lb-cta__note {
    margin-top: 24px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
  }

  @keyframes floatBtn {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
    100% {
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .lb-cta {
      padding: 80px 24px;
    }
    .lb-btn-white {
      padding: 16px 36px;
      font-size: 1rem;
    }
  }
</style>
