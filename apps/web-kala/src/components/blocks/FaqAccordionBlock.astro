---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  block: {
    title: string;
    subtitle?: string;
    faqs: FaqItem[];
  };
}

const { block } = Astro.props;
const faqs = block.faqs || [];
---

<section class="py-14 md:py-20 bg-[#FFF9F4] border-b border-[#F6DCCD]">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    
    <!-- Header -->
    <div class="text-center mb-12">
      <span class="text-xs font-bold tracking-wider text-[#C2552B] uppercase bg-[#FFEFE5] px-3.5 py-1.5 rounded-full border border-[#F6DCCD] inline-block mb-3">
        Tanya Jawab Seputar Homecare
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-brand font-bold text-[#4B2E22] mb-3">
        {block.title}
      </h2>
      {block.subtitle && (
        <p class="text-sm sm:text-base text-[#86675A] max-w-xl mx-auto">
          {block.subtitle}
        </p>
      )}
    </div>

    <!-- Accordion List -->
    <div class="space-y-4">
      {faqs.map((faq, idx) => (
        <details class="group bg-white rounded-2xl border border-[#F6DCCD] overflow-hidden transition-all duration-200 open:shadow-md" open={idx === 0}>
          <summary class="flex items-center justify-between gap-4 p-5 sm:p-6 cursor-pointer select-none font-bold text-[#4B2E22] text-sm sm:text-base list-none">
            <span>{faq.q}</span>
            <span class="w-7 h-7 rounded-full bg-[#FFEFE5] text-[#C2552B] flex items-center justify-center text-xs font-bold transition-transform duration-200 group-open:rotate-180 flex-shrink-0 border border-[#F6DCCD]">
              ▼
            </span>
          </summary>
          <div class="px-5 pb-5 sm:px-6 sm:pb-6 text-xs sm:text-sm text-[#86675A] leading-relaxed border-t border-[#F6DCCD]/40 pt-4">
            {faq.a}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
