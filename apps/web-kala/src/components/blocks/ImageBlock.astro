---
import { mediaUrl, mediaAlt } from '../../lib/payload';

interface Props {
  block: {
    image?: { url?: string; alt?: string } | string;
    imageUrlFallback?: string;
    alt?: string;
    caption?: string;
    link?: string;
    width?: 'normal' | 'wide' | 'full';
    align?: 'left' | 'center' | 'right';
    ratio?: 'auto' | '16:9' | '4:3' | '1:1';
    rounded?: 'none' | 'md' | 'lg';
  };
}

const { block } = Astro.props;

const src = mediaUrl(block.image, block.imageUrlFallback || '');
const alt = block.alt || mediaAlt(block.image, '');

const widthClasses: Record<string, string> = {
  normal: 'max-w-4xl',
  wide: 'max-w-6xl',
  full: 'max-w-none',
};
const alignClasses: Record<string, string> = {
  left: 'mr-auto',
  center: 'mx-auto',
  right: 'ml-auto',
};
const ratioClasses: Record<string, string> = {
  auto: '',
  '16:9': 'aspect-video object-cover',
  '4:3': 'aspect-[4/3] object-cover',
  '1:1': 'aspect-square object-cover',
};
const roundedClasses: Record<string, string> = {
  none: 'rounded-none',
  md: 'rounded-2xl',
  lg: 'rounded-3xl',
};

const imgClass = `w-full h-auto ${ratioClasses[block.ratio || 'auto']} ${roundedClasses[block.rounded || 'md']}`;
---

{src && (
  <section class="py-8 md:py-10">
    <div class="px-4 sm:px-6">
      <figure class={`${widthClasses[block.width || 'normal']} ${alignClasses[block.align || 'center'] || ''}`}>
        {block.link ? (
          <a href={block.link} class="block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B3471E] rounded-2xl">
            <img src={src} alt={alt} class={imgClass} loading="lazy" decoding="async" />
          </a>
        ) : (
          <img src={src} alt={alt} class={imgClass} loading="lazy" decoding="async" />
        )}
        {block.caption && (
          <figcaption class="mt-3 text-xs sm:text-sm text-[#86675A] text-center leading-relaxed">
            {block.caption}
          </figcaption>
        )}
      </figure>
    </div>
  </section>
)}
